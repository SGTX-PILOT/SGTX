# =============================================================================
# .dockerignore — keep the Docker build context lean & reproducible
# =============================================================================

# --- Dependencies (reinstalled inside the image) ---
node_modules
**/node_modules

# --- Next.js build output (rebuilt inside the image) ---
.next
out

# --- Version control ---
.git
.gitignore
.gitattributes

# --- Logs ---
*.log
dev.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Environment files (never bake secrets into images) ---
.env
.env.local
.env.*.local

# --- SQLite database files (runtime state, not build input) ---
db/*.db
db/*.db-journal
*.sqlite
*.sqlite-journal

# --- Runtime / agent scratch artefacts ---
tool-results
screenshots
agent-ctx
upload
download
coverage
.cache
*.tsbuildinfo

# --- Editor / OS noise ---
.DS_Store
.vscode
.idea
*.swp
*.swo

# --- Docker meta (don't send to the builder) ---
Dockerfile
.dockerignore
docker-compose*.yml
