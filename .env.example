# SGTX Platform Environment Variables
# Copy this file to .env and fill in real values for production.
# Generate secrets with: openssl rand -hex 32

# ============ Database ============
# SQLite (dev). Production should use Postgres: postgresql://user:pass@host:5432/db
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ============ Authentication Secrets (REQUIRED in production) ============
SGTX_SESSION_SECRET=generate-with-openssl-rand-hex-32
SGTX_REFRESH_SECRET=generate-with-openssl-rand-hex-32

# ============ Cron Secret ============
CRON_SECRET=generate-with-openssl-rand-hex-32

# ============ Platform Signing Key ============
# Ed25519 private key (32 bytes = 64 hex chars) for signing Trust Passports,
# Governor decisions, QES, and break-glass events.
SGTX_PLATFORM_KEY=generate-with-openssl-rand-hex-32

# ============ Dev Mode ============
# Set to "true" to bypass JWT auth in development (NOT for production)
SGTX_DEV_BYPASS_AUTH=true

# ============ AI Provider Keys (optional) ============
ZAI_API_KEY=your-zai-api-key
GROQ_API_KEY=your-groq-api-key

# ============ CORS (production) ============
# Comma-separated list of allowed origins
SGTX_ALLOWED_ORIGINS=

# ============ Logging ============
# Log level: debug | info | warn | error
SGTX_LOG_LEVEL=info

# ============ Node Environment ============
NODE_ENV=development
