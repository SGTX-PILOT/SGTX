  // Additional DG-specific fields
  inhalationHazard    Boolean  @default(false)
  poisonInhalationHazard String? // Zone A | Zone B
  reportableQuantityKg Float?  // CERCLA reportable quantity
  createdAt           DateTime @default(now())

  @@index([containerId])
  @@index([ustn])
  @@index([unNumber])
  @@index([imdgClass])
}

// ============ Lot Number System (container → lots → pallets) ============

model Lot {
  id              String   @id @default(cuid())
  lotNumber       String   // unique lot identifier (e.g. "LOT-2026-001-EG-FROZEN-001")
  ustn            String
  tradeId         String
  shipmentId      String?  // optional: assigned to a specific shipment
  containerId     String?  // optional: assigned to a specific container
  commodity       String
  commodityHs     String?
  originCountry   String
  productionDate  DateTime?
  expiryDate      DateTime?
  bestBeforeDate  DateTime?
  batchNumber     String?  // manufacturer's batch number
  harvestDate     DateTime? // for agricultural products
  packDate        DateTime?
  supplierGtid    String?  // original supplier/producer
  supplierLotRef  String?  // supplier's own lot reference
  quantityUnits   Int      @default(0)  // total cartons/units in this lot
  netWeightKg     Float    @default(0)
  grossWeightKg   Float    @default(0)
  coldStorageTemp Float?   // required storage temperature
  treatmentStatus String?  // fumigated | cold-treated | irradiated | none
  organicCertified Boolean @default(false)
  gmoStatus       String?  // "GMO" | "NON-GMO" | "UNKNOWN"
  allergenInfo    String?  // allergen declaration
  countryOfOrigin String?  // final country of origin determination
  notes           String?
  status          String   @default("ACTIVE") // ACTIVE | QUARANTINED | REJECTED | RELEASED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  // Relations
  shipment        Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  container       TradeContainer? @relation(fields: [containerId], references: [id], onDelete: SetNull)
  pallets         PalletDetail[]

  @@unique([lotNumber, ustn])
  @@index([ustn])
  @@index([tradeId])
  @@index([shipmentId])
  @@index([containerId])
  @@index([commodityHs])
  @@index([status])
  @@index([expiryDate])
}

// ============ Tier 2: Letter of Credit (UCP 600 terms) ============

model LetterOfCredit {
  id                  String   @id @default(cuid())
  ustn                String
  tradeId             String
  lcNumber            String   @unique // issuing bank's L/C number
  lcType              String   // "IRREVOCABLE" | "REVOCABLE" | "CONFIRMED" | "UNCONFIRMED" | "STANDBY" | "REVOLVING"
  issuanceDate        DateTime
  expiryDate          DateTime
  expiryPlace         String?
  issuingBankGtid     String?
  issuingBankName     String
  advisingBankGtid    String?
  advisingBankName    String?
  confirmingBankGtid  String?
  confirmingBankName  String?
  // Parties
  applicantName       String
  applicantAddress    String?
  applicantGtid       String?
  beneficiaryName     String
  beneficiaryAddress  String?
  beneficiaryGtid     String?
  // Amount
  currency            String   @default("USD")
  amount              Float
  tolerancePlus       Float    @default(0) // percentage tolerance
  toleranceMinus      Float    @default(0)
  maxCreditAmount     Float?   // for revolving L/C
  // Shipment terms
  portOfLoading       String?
  portOfDischarge     String?
  placeOfDelivery     String?
  latestShipmentDate  DateTime?
  partialShipments    String   @default("ALLOWED") // ALLOWED | NOT_ALLOWED
  transshipments      String   @default("ALLOWED") // ALLOWED | NOT_ALLOWED
  // Documents required (JSON array of document types)
  requiredDocuments   String   @default("[]") // e.g. ["COMMERCIAL_INVOICE","BILL_LADING","COO","PACKING_LIST","INSURANCE_CERT"]
  documentCount       Int      @default(0)
  // Presentation
  presentationDays   Int      @default(21) // UCP 600 Art. 14(i) — 21 days from B/L date
  presentationPlace  String?
  // Charges
  bankingCharges      String   @default("BENEFICIARY") // BENEFICIARY | APPLICANT | SHARED
  confirmationCharges String?
  // Status
  status              String   @default("ISSUED") // ISSUED | ADVISED | CONFIRMED | AMENDED | PRESENTED | EXAMINED | PAID | DISCREPANT | REFUSED | EXPIRED | CANCELLED
  amendedFrom         String?  // original L/C number if amended
  amendmentCount      Int      @default(0)
  // UCP 600 validation results
  lastValidationAt    DateTime?
  lastValidationResult String? // JSON: { discrepancies: [], warnings: [], verdict: "COMPLIANT"|"DISCREPANT"|"WARNING" }
  discrepancyCount    Int      @default(0)
  // Audit
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([tradeId])
  @@index([status])
  @@index([expiryDate])
  @@index([issuingBankGtid])
}

// ============ Tier 2: Certificate of Origin (persisted) ============

model CertificateOfOrigin {
  id              String   @id @default(cuid())
  ustn            String
  tradeId         String
  certificateNumber String @unique // e.g. "EUR1-2026-FRZ358KP"
  certificateType String   // EUR.1 | EUR-MED | A.TR | GSP | COO_GENERAL | AR.1 | COMESA | AFCFTA | FORM_E | FORM_D | REX
  originCountry   String
  destinationCountry String
  issuingAuthority String
  issuerGtid      String?
  // Goods
  commodity       String
  commodityHs     String
  originCriterion String?  // "W" (wholly obtained) | "P" (sufficient transformation) | "PSR" (product-specific rule)
  cumulationType  String?  // "BILATERAL" | "DIAGONAL" | "FULL" | "NONE"
  cumulationCountries String? // JSON array of cumulation partners
  // Value
  currency        String   @default("USD")
  invoiceValue    Float
  // Validity
  issueDate       DateTime @default(now())
  expiryDate      DateTime?
  validityMonths  Int      @default(10)
  // Status
  status          String   @default("ISSUED") // ISSUED | PRESENTED | VERIFIED | REJECTED | EXPIRED | REVOKED
  verifiedBy      String?  // customs authority that verified
  verifiedAt      DateTime?
  // QIZ (Egypt→US)
  qizAnnotated    Boolean  @default(false)
  qizNumber       String?
  // Document
  documentHash    String?  // SHA-256 of generated content
  pdfUrl          String?
  verificationUrl String?  // public verification URL with QR
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([tradeId])
  @@index([certificateType])
  @@index([status])
  @@index([expiryDate])
}

// ============ Tier 3: Reefer Telemetry (time-series) ============

model ReeferTelemetry {
  id              String   @id @default(cuid())
  shipmentId      String
  containerId     String?
  ustn            String
  timestamp       DateTime @default(now())
  // Temperature
  setpointTempC   Float?   // target temperature
  actualTempC     Float    // recorded temperature
  supplyAirTempC  Float?   // supply air (evaporator outlet)
  returnAirTempC  Float?   // return air (evaporator inlet)
  // Humidity
  humidityPct     Float?   // relative humidity %
  // Atmosphere (controlled atmosphere)
  o2Pct           Float?   // oxygen %
  co2Pct          Float?   // carbon dioxide %
  n2Pct           Float?   // nitrogen %
  // Equipment
  powerStatus     String?  // ON | OFF | DEFROST | STANDBY
  fuelLevelPct    Float?   // for genset-equipped reefers
  batteryVoltage  Float?
  // Location
  lat             Float?
  lng             Float?
  // Alert flags
  tempExcursion   Boolean  @default(false)
  doorOpen        Boolean  @default(false)
  powerFailure    Boolean  @default(false)
  defrostCycle    Boolean  @default(false)
  // Source
  source          String   @default("MANUAL") // MANUAL | CARRIER_TRANSICOLD | THERMO_KING | ROAMBEE | TIVE | SENSITECH | ELPRO
  deviceId        String?  // monitoring device ID
  rawPayload      String?  // JSON: raw telemetry from provider

  shipment        Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([ustn])
  @@index([timestamp])
  @@index([tempExcursion])
  @@index([source])
}

// ============================================================================
// FREE-INTEGRATIONS (CTO-Free-Integrations): Public-data sync tables
// ============================================================================
// All of these models back FREE, no-API-key, no-billing integrations:
//   - OFAC SDN list (US Treasury public CSV)
//   - UN Security Council consolidated sanctions (public XML)
//   - EU Consolidated sanctions list (public XML)
//   - FX reference rates (open.er-api.com + ECB daily XML)
//   - UN/LOCODE port + location codes (per-country public CSV)
//   - World Bank monthly commodity prices (public JSON)
//   - REST Countries + World Bank country metadata (public JSON)
//   - Open-Meteo port weather snapshots (free, no key)
// ============================================================================

model OfacSdnEntry {
  id          String   @id @default(cuid())
  sdnId       String   @unique
  name        String
  entityType  String   // individual | entity | vessel | aircraft
  program     String?
  title       String?
  remarks     String?
  aliases     String?  // JSON array
  syncedAt    DateTime @default(now())

  @@index([name])
  @@index([entityType])
}

model UnSanctionsEntry {
  id          String   @id @default(cuid())
  unId        String   @unique
  name        String
  entityType  String
  program     String?
  aliases     String?  // JSON array
  syncedAt    DateTime @default(now())

  @@index([name])
}

model EuSanctionsEntry {
  id              String   @id @default(cuid())
  euId            String   @unique
  name            String
  entityType      String
  program         String?
  remarks         String?
  aliases         String?
  syncedAt        DateTime @default(now())

  @@index([name])
}

model FxRate {
  id          String   @id @default(cuid())
  base        String   // USD, EUR
  quote       String   // EGP, SAR, etc
  rate        Float
  source      String   // open.er-api.com | ecb
  syncedAt    DateTime @default(now())

  @@unique([base, quote, source])
  @@index([base, quote])
}

model UnlocodeEntry {
  id          String   @id @default(cuid())
  unlocode    String   @unique
  name        String
  countryCode String
  subdivision String?
  function    String?  // port, airport, border, etc
  coordinates String?  // "lat,lng"
  syncedAt    DateTime @default(now())

  @@index([countryCode])
  @@index([name])
}

model WorldBankPrice {
  id          String   @id @default(cuid())
  commodity   String
  price       Float
  unit        String
  date        String
  syncedAt    DateTime @default(now())

  @@unique([commodity, date])
  @@index([commodity])
}

model CountryData {
  id              String   @id @default(cuid())
  countryCode     String   @unique // ISO 3166-1 alpha-2
  name            String
  officialName    String?
  region          String?
  subregion       String?
  capital         String?
  currencies      String?  // JSON
  languages       String?  // JSON
  flagUrl         String?
  callingCode     String?
  coordinates     String?  // "lat,lng"
  incomeLevel     String?  // from World Bank
  syncedAt        DateTime @default(now())

  @@index([region])
}

model WeatherData {
  id           String   @id @default(cuid())
  portUnlocode String?
  lat          Float
  lng          Float
  temperature  Float
  windSpeed    Float
  weatherCode  Int
  description  String?
  syncedAt     DateTime @default(now())

  @@index([portUnlocode])
  @@index([syncedAt])
}

// Consolidated log for all free-integration sync runs (sanctions, FX, UN/LOCODE,
// weather, commodity prices, country data). One row per sync attempt.
model FreeIntegrationSyncLog {
  id          String   @id @default(cuid())
  integration String   // ofac-sdn | un-sanctions | eu-sanctions | fx-rates |
                       // unlocode | worldbank-prices | rest-countries | weather | gdelt
  source      String   // open.er-api.com | ecb | treasury.gov | ...
  syncedAt    DateTime @default(now())
  durationMs  Int
  recordsUpserted Int   @default(0)
  errors      String?  // JSON array of error strings
  status      String   @default("SUCCESS") // SUCCESS | PARTIAL | FAILED

  @@index([integration])
  @@index([syncedAt])
}

// ============ Logistics Orchestration (Mode A/B/C Normalized Quote System) ============

model LogisticsQuote {
  id                  String   @id @default(cuid())
  quoteId             String   @unique  // LQ-YYYYMMDD-NNNNN
  ustn                String
  tradeId             String
  serviceType         String   // TRUCKING | WAREHOUSING | CUSTOMS_BROKERAGE | OCEAN_FREIGHT | THC | INSURANCE | DESTINATION_HANDLING
  sourceMode          String   // MODE_A | MODE_B | MODE_C
  providerGtid        String?  // null for Mode A (manual), set for Mode B/C
  providerType        String?  // LSP | SHIP | CBR (null for Mode A)
  status              String   @default("DRAFT") // DRAFT | REQUESTED | QUOTED | EXPIRING | EXPIRED | RECONFIRM_REQUIRED | SELECTED | CAPACITY_PENDING | CAPACITY_CONFIRMED | BOOKING_PENDING | BOOKED | CANCELLED | SUPERSEDED
  currentVersion      Int      @default(1)

  // Origin/Destination
  origin              String?
  destination         String?
  route               String?

  // Service details
  commodity           String?
  quantity            Float?
  weightKg            Float?
  volumeCbm           Float?
  equipmentType       String?  // 40RF, 20ST, etc
  equipmentCount      Int      @default(1)

  // Pricing
  currency            String   @default("USD")
  baseCost            Float    @default(0)
  knownSurchargesJson String   @default("[]") // JSON: [{type, amount, description}]
  conditionalCostJson String   @default("[]") // JSON: [{type, amount, description, condition}]
  excludedCostJson    String   @default("[]") // JSON: [{type, description}]
  estimatedTotal      Float    @default(0)
  maximumExposure     Float    @default(0)  // base + known + conditional

  // Validity
  issuedAt            DateTime?
  validUntil          DateTime?

  // Capacity
  capacityStatus      String   @default("PENDING") // PENDING | AVAILABLE | HELD | CONFIRMED | LOST
  capacityHoldExpiry  DateTime?
  sailingDate         DateTime?
  cutoffDate          DateTime?
  bookingReference    String?
  bookingConfirmedAt  DateTime?

  // Assumptions & Conditions
  assumptionsJson     String   @default("[]") // JSON: [{key, value}]
  conditionsJson      String   @default("[]") // JSON: [{condition, description}]
  cancellationTerms   String?

  // Service Commitment
  pickupCommitment    DateTime?
  deliveryCommitment  DateTime?
  responseSLA         Int?     // hours
  liability           String?
  documentationResp   String?
  penaltyTerms        String?
  escalationProcess   String?

  // Route Feasibility
  feasibilityStatus   String?  // FEASIBLE | CONDITIONALLY_FEASIBLE | NOT_FEASIBLE
  feasibilityNotes    String?

  // Fallback
  isFallback          Boolean  @default(false)
  fallbackLevel       String?  // PRIMARY | BACKUP | EMERGENCY
  fallbackParentId    String?  // reference to primary quote if this is a fallback

  // Audit
  selectedByGtid      String?
  selectedAt          DateTime?
  supersededBy        String?  // quoteId of newer version
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([tradeId])
  @@index([providerGtid])
  @@index([status])
  @@index([sourceMode])
}

model LogisticsQuoteVersion {
  id              String   @id @default(cuid())
  quoteId         String   // reference to LogisticsQuote.quoteId
  version         Int
  actorGtid       String
  changedAt       DateTime @default(now())
  reason          String
  beforeJson      String   @default("{}") // JSON snapshot of previous state
  afterJson       String   @default("{}") // JSON snapshot of new state
  governorDecision String? // Governor decision ID if governed

  @@index([quoteId])
  @@index([version])
}

model LogisticsQuoteSurcharge {
  id              String   @id @default(cuid())
  quoteId         String
  surchargeType   String   // FUEL | BUNKER | PEAK_SEASON | THC | PORT_CHARGES | DOCUMENTATION | REEFER | WAITING | DEMURRAGE | DETENTION | STORAGE | HOLIDAY | EQUIPMENT_IMBALANCE | INSPECTION | CUSTOMS_EXTRAS
  amount          Float
  currency        String   @default("USD")
  description     String?
  isConditional   Boolean  @default(false)
  condition       String?  // when isConditional=true
  isExcluded      Boolean  @default(false) // if true, this is an excluded cost

  @@index([quoteId])
  @@index([surchargeType])
}

model LogisticsQuoteAssumption {
  id              String   @id @default(cuid())
  quoteId         String
  key             String   // COMMODITY | QUANTITY | EQUIPMENT | ORIGIN | PORT | PICKUP | INCLUDED | EXCLUDED | VALID_UNTIL
  value           String
  isExclusion     Boolean  @default(false) // if true, this is an exclusion

  @@index([quoteId])
}

model LogisticsCapacity {
  id              String   @id @default(cuid())
  quoteId         String
  equipmentType   String
  quantity        Int
  status          String   @default("PENDING") // PENDING | AVAILABLE | HELD | CONFIRMED | LOST
  holdExpiry      DateTime?
  sailingDate     DateTime?
  cutoffDate      DateTime?
  bookingRef      String?
  confirmedAt     DateTime?
  confirmedBy     String?

  @@index([quoteId])
  @@index([status])
}

model LogisticsBooking {
  id              String   @id @default(cuid())
  quoteId         String
  ustn            String
  bookingRef      String   @unique
  providerGtid    String
  status          String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED | AMENDED
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  cancellationReason String?
  amendedFrom     String?  // previous bookingRef if amended
  createdAt       DateTime @default(now())

  @@index([quoteId])
  @@index([ustn])
  @@index([providerGtid])
}

model LogisticsServiceCommitment {
  id                  String   @id @default(cuid())
  quoteId             String
  ustn                String
  pickupCommitment    DateTime?
  deliveryCommitment  DateTime?
  equipmentCommitment String?
  capacityCommitment  String?
  responseSLA         Int?     // hours
  cancellationConditions String?
  liability           String?
  documentationResponsibility String?
  penaltyTerms        String?
  escalationProcess   String?
  createdAt           DateTime @default(now())

  @@index([quoteId])
  @@index([ustn])
}

model LogisticsDriftEvent {
  id              String   @id @default(cuid())
  quoteId         String
  ustn            String
  driftType       String   // PRICE_CHANGE | SURCHARGE_CHANGE | CAPACITY_LOST | SCHEDULE_CHANGE | BOOKING_CHANGE | INVOICE_VARIANCE
  originalAmount  Float?
  currentAmount   Float?
  difference      Float?
  percentageChange Float?
  reason          String
  affectedService String?
  contractImpact  String?
  requiredAction  String?
  detectedAt      DateTime @default(now())
  resolvedAt      DateTime?
  resolutionNotes String?

  @@index([quoteId])
  @@index([ustn])
  @@index([driftType])
}

model LogisticsFallback {
  id              String   @id @default(cuid())
  ustn            String
  serviceType     String   // OCEAN_FREIGHT | TRUCKING | etc
  primaryQuoteId  String
  backupQuoteId   String?
  emergencyQuoteId String?
  status          String   @default("ACTIVE") // ACTIVE | PRIMARY_FAILED | BACKUP_ACTIVATED | EMERGENCY_ACTIVATED
  activatedBy     String?  // GTID of seller who activated fallback
  activatedAt     DateTime?
  governorDecision String? // Governor decision ID
  createdAt       DateTime @default(now())

  @@index([ustn])
  @@index([serviceType])
}

model LogisticsRouteFeasibility {
  id              String   @id @default(cuid())
  quoteId         String
  ustn            String
  pickupDate      DateTime?
  loadingDate     DateTime?
  portCutoff      DateTime?
  sailingDate     DateTime?
  transitTimeDays Int?
  customsLeadDays Int?
  inspectionDays  Int?
  expectedArrival DateTime?
  deliveryDeadline DateTime?
  availableBuffer  Int?    // days
  status          String   // FEASIBLE | CONDITIONALLY_FEASIBLE | NOT_FEASIBLE
  notes           String?
  blockingConditions String? // JSON array
  checkedAt       DateTime @default(now())

  @@index([quoteId])
  @@index([ustn])
}

model ProviderEligibility {
  id              String   @id @default(cuid())
  providerGtid    String   @unique
  licenseStatus   String   @default("PENDING") // VERIFIED | PENDING | EXPIRED | NOT_REQUIRED
  licenseNumber   String?
  licenseExpiry   DateTime?
  insuranceStatus String   @default("PENDING") // VALID | PENDING | EXPIRED | NOT_REQUIRED
  insuranceProvider String?
  insuranceExpiry DateTime?
  jurisdictionEligible String? // JSON array of ISO country codes
  sanctionsStatus String   @default("CLEAR") // CLEAR | FLAGGED | BLOCKED
  sanctionsCheckedAt DateTime?
  serviceCapabilities String? // JSON array of service types
  routeCapabilities String?  // JSON array of route codes
  equipmentCapabilities String? // JSON array of equipment types
  capacityConfirmed Boolean @default(false)
  updatedAt       DateTime @default(now()) @updatedAt
  createdAt       DateTime @default(now())

  @@index([providerGtid])
  @@index([licenseStatus])
  @@index([sanctionsStatus])
}

// SGTX Brain OS — Continuous Learning Persistence (CCL-003)
// These tables ensure the Brain's learning state survives Vercel serverless
// cold starts. Previously LearningFeedback + WorldwideRouteObservation were
// in-memory only — lost on every function instance recycle.

model LearningFeedbackRecord {
  id              String   @id @default(cuid())
  decisionId      String
  capability      String
  actualOutcome   String   // "success" | "failure" | "partial"
  outcomeDetails  String   // JSON: { expected, actual, deviation, source }
  feedbackSource  String   @default("outcome-monitor") // "system" | "human" | "outcome-monitor"
  qualityScore    Float?   // 0.0-1.0 — how reliable this feedback is
  recordedAt      DateTime @default(now())

  @@index([capability])
  @@index([recordedAt])
  @@index([decisionId])
}

model WorldwideRouteObservation {
  id                     String   @id @default(cuid())
  routeId                String
  predictedPriceUsd      Float
  predictedTransitDays   Int
  actualPriceUsd         Float?
  actualTransitDays      Int?
  priceDeviationPct      Float?
  transitDeviationDays   Int?
  observationSource      String   @default("brain-sync") // "brain-sync" | "provider-quote" | "final-invoice"
  observedAt             DateTime @default(now())

  @@index([routeId])
  @@index([observedAt])
}

model BrainDailyRun {
  id              String   @id @default(cuid())
  runDate         DateTime @default(now())
  stepsCompleted   String   // JSON array of step names that succeeded
  stepsFailed      String   // JSON array of step names that failed
  totalDurationMs  Int
  routesDriftApplied Float?
  sanctionsRefreshed Int?
  fxRatesRefreshed Int?
  fineTuningExamplesAdded Int?
  status          String   @default("COMPLETED") // "COMPLETED" | "PARTIAL" | "FAILED"

  @@index([runDate])
  @@index([status])
}

// SGTX Buyer Trade Request UX Enhancement (CCL-004)
// Buyer Priority & Trade-Off Profile + Field Explanations + Completeness State

model BuyerTradePriority {
  id              String   @id @default(cuid())
  tradeId         String   @unique
  // 6 priority axes, each: "CRITICAL" | "IMPORTANT" | "NORMAL"
  price           String   @default("NORMAL")
  quality         String   @default("NORMAL")
  deliveryCertainty String @default("NORMAL")
  costCertainty   String   @default("NORMAL")
  scheduleCertainty String @default("NORMAL")
  reliability     String   @default("NORMAL")
  // Default profile: "BALANCED" (all NORMAL)
  profilePreset   String   @default("BALANCED")
  updatedAt       DateTime @default(now()) @updatedAt
  createdAt       DateTime @default(now())

  @@index([tradeId])
}

model BuyerFieldExplanation {
  id              String   @id @default(cuid())
  fieldKey        String   @unique
  category        String   // "PRODUCT" | "TRANSPORT" | "INCOTERM" | "DOCUMENTATION" | "ACCEPTANCE" | "INSURANCE" | "SETTLEMENT"
  shortReason     String   // 1-line plain-language explanation
  detailedReason  String?  // expanded explanation (for tooltip expansion)
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([fieldKey])
  @@index([category])
}

model BuyerRequestCompletenessState {
  id              String   @id @default(cuid())
  tradeId         String   @unique
  // JSON: { category: "COMPLETE"|"MISSING"|"OPTIONAL"|"NOT_APPLICABLE"|"BLOCKED", missingItems: [...], blockingReasons: [...] }
  completenessMap String
  overallState    String   @default("INCOMPLETE") // "READY" | "READY_WITH_OPTIONAL" | "INCOMPLETE" | "CONDITIONALLY_READY" | "BLOCKED"
  missingCount    Int      @default(0)
  blockingCount   Int      @default(0)
  updatedAt       DateTime @default(now()) @updatedAt
  createdAt       DateTime @default(now())

  @@index([tradeId])
  @@index([overallState])
}

// Part 31: Add-On 8 — Customs Bond & Guarantee Management (CCL-006)
model CustomsBond {
  id              String    @id @default(cuid())
