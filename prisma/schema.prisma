// ===========================================================================
// PHASE 5 — Global Transport & Logistics Execution Fabric (CCL-018)
// One orchestration layer OVER the existing mode engines (road-corridor,
// air-cargo, sea, rail). Does NOT duplicate their logic. Adds: multi-leg
// transport graph, provider relationship model (non-marketplace), expanded
// logistics quote, landed cost engine, transport documents, provider
// validation.
// ===========================================================================

// --- §1 Transport Graph ---
// One USTN may contain multiple legs. Each leg is one mode segment.
// Example: ROAD → OCEAN → ROAD (3 legs).
model TransportGraph {
  id                  String   @id @default(cuid())
  ustn                String?  // linked trade
  tradeId             String?
  name                String?
  description         String?
  totalLegs           Int      @default(0)
  primaryMode         String?  // the dominant mode (e.g. OCEAN for ROAD-OCEAN-ROAD)
  isMultimodal        Boolean  @default(false)
  originLocation      String?  // UN/LOCODE or address
  destinationLocation String?
  estimatedTransitDays Int?
  estimatedTotalCostUsd Float?
  currency            String   @default("USD")
  status              String   @default("PLANNED") // PLANNED | CONFIRMED | IN_TRANSIT | COMPLETED | CANCELLED | DISRUPTED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  legs                TransportLeg[]

  @@index([ustn])
  @@index([tradeId])
  @@index([status])
  @@index([primaryMode])
}

// --- §1b Transport Leg ---
// A single mode segment within a transport graph. Each leg delegates
// execution to the relevant mode engine (road-corridor / air-cargo / etc.)
// via `modeEngineRef` (the id of the mode-specific record).
model TransportLeg {
  id                  String   @id @default(cuid())
  graphId             String   // TransportGraph
  legNumber           Int      // 1-based sequence
  legType             String   // ORIGIN | INTERMEDIATE | DESTINATION
  mode                String   // ROAD | AIR | OCEAN | RAIL | FERRY | MULTIMODAL
  originLocation      String
  destinationLocation String?
  // Handoff point — where this leg ends and the next begins (e.g. port/airport)
  handoffLocation     String?  // UN/LOCODE
  handoffType         String?  // PORT_TO_PORT | AIRPORT_TO_AIRPORT | DOOR_TO_PORT | PORT_TO_DOOR | DOOR_TO_DOOR | RAIL_YARD | FERRY_TERMINAL
  // Provider for this leg
  providerGtid        String?
  providerType        String?  // LSP | FREIGHT_FORWARDER | SHIPPING_LINE | AIRLINE | RAIL_OPERATOR | FERRY | WAREHOUSE | TERMINAL | GHA | CUSTOMS_BROKER | LAB | QC | INSURANCE
  // Link to the mode-specific engine record (road-corridor / air-cargo / etc.)
  modeEngineRef       String?  // id in the mode engine's table
  modeEngineType      String?  // ROAD_CORRIDOR | AIR_CARGO | OCEAN_SHIPMENT | RAIL_CONSIGNMENT | FERRY_DOCUMENT
  // Documents for this leg
  documents           String?  // JSON array of transport document ids
  // Status
  status              String   @default("PLANNED") // PLANNED | BOOKED | IN_TRANSIT | AT_HANDOFF | COMPLETED | CANCELLED | DELAYED
  plannedDeparture    DateTime?
  plannedArrival      DateTime?
  actualDeparture     DateTime?
  actualArrival       DateTime?
  // Cost summary for this leg
  estimatedCostUsd    Float?
  actualCostUsd       Float?
  currency            String   @default("USD")
  // Mode-specific metadata (the mode engine populates this)
  modeMetadata        String?  // JSON
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  graph               TransportGraph @relation(fields: [graphId], references: [id], onDelete: Cascade)

  @@index([graphId])
  @@index([mode])
  @@index([providerGtid])
  @@index([status])
  @@index([legNumber])
}

// --- §2 Provider Relationship Model ---
// One row per (provider × trader) relationship. SGTX is NON-MARKETPLACE —
// providers are only visible based on: approved relationship, saved contact,
// GTID, explicit selection, authorized government relationship.
// NEVER public rankings.
model ProviderRelationship {
  id                  String   @id @default(cuid())
  providerGtid        String   // the logistics provider's GTID
  providerType        String   // LSP | FREIGHT_FORWARDER | SHIPPING_LINE | AIRLINE | RAIL_OPERATOR | FERRY | WAREHOUSE | TERMINAL | GHA | CUSTOMS_BROKER | LAB | QC | INSURANCE
  traderGtid         String?  // the trader who has the relationship (null = platform-wide approved)
  relationshipType    String   // APPROVED | SAVED_CONTACT | GTID_VERIFIED | EXPLICIT_SELECTION | GOVERNMENT_AUTHORIZED
  relationshipStatus  String   @default("ACTIVE") // ACTIVE | INACTIVE | SUSPENDED | EXPIRED
  // Visibility scope
  visibilityScope     String   @default("PRIVATE") // PRIVATE (trader-only) | PLATFORM (all SGTX users) | GOVERNMENT
  jurisdictions      String?  // JSON array of jurisdiction codes the provider operates in
  routes             String?  // JSON array of routes (origin-dest pairs) the provider serves
  serviceCatalogue   String?  // JSON array of service types
  // Authorization
  authorizedFrom     DateTime?
  authorizedUntil    DateTime?
  authorizedBy       String?  // who granted the authorization
  // Non-marketplace: NO ranking, NO public score. Performance is private.
  internalTrustScore Int      @default(70) // 0..100 — internal, never shown publicly
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@unique([providerGtid, traderGtid, relationshipType])
  @@index([providerGtid])
  @@index([traderGtid])
  @@index([providerType])
  @@index([relationshipStatus])
}

// --- §3 Logistics Quote V2 (Phase 5 expanded) ---
// Extends the existing LogisticsQuote model (line 3902) with Phase 5
// service types: ROAD, AIR, OCEAN, RAIL, MULTIMODAL, WAREHOUSE, TERMINAL,
// CUSTOMS_BROKER, INSPECTION, LAB, QC, INSURANCE.
model LogisticsQuoteV2 {
  id                  String   @id @default(cuid())
  ustn                String?
  tradeId             String?
  graphId             String?  // TransportGraph (if multi-leg)
  legId              String?  // TransportLeg (if per-leg quote)
  quoteId            String   @unique  // LQ2-YYYYMMDD-NNNNN
  // Expanded service types (§3)
  serviceType         String   // ROAD | AIR | OCEAN | RAIL | MULTIMODAL | WAREHOUSE | TERMINAL | CUSTOMS_BROKER | INSPECTION | LAB | QC | INSURANCE
  serviceSubtype     String?  // e.g. FCL, LCL, FTL, LTL, AIR_EXPRESS, AIR_STANDARD
  // Provider
  providerGtid       String?
  providerType       String?
  // Origin/Destination (per-leg)
  originLocation     String?
  destinationLocation String?
  // Cargo details
  commodity          String?
  hs6                String?
  weightKg           Float?
  volumeCbm          Float?
  equipmentType      String?
  equipmentCount     Int      @default(1)
  specialCargo       String?  // JSON: { reefer, dg, oversized, perishable }
  // Pricing
  currency           String   @default("USD")
  baseCost           Float    @default(0)
  surcharges         String?  // JSON array of { type, amount, description }
  totalCost          Float    @default(0)
  maxExposure         Float    @default(0)
  // Validity
  issuedAt           DateTime?
  validUntil         DateTime?
  // Selection
  status             String   @default("DRAFT") // DRAFT | REQUESTED | QUOTED | SELECTED | EXPIRED | CANCELLED | SUPERSEDED
  selectedByGtid     String?
  selectedAt         DateTime?
  // Link to legacy LogisticsQuote (if created via the old system)
  legacyQuoteId      String?
  // Provider validation status (§6)
  providerValidationStatus String? @default("PENDING") // PENDING | VALIDATED | INVALID | EXPIRED
  providerValidationId     String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([graphId])
  @@index([legId])
  @@index([providerGtid])
  @@index([serviceType])
  @@index([status])
}

// --- §4 Landed Cost Breakdown ---
// The 20 cost components per the spec, for one transport graph (or single leg).
// This is the "true landed logistics cost".
model LandedCostBreakdown {
  id                  String   @id @default(cuid())
  ustn                String?
  tradeId             String?
  graphId             String?  // TransportGraph
  legId              String?  // TransportLeg (if per-leg)
  quoteId            String?  // LogisticsQuoteV2
  currency            String   @default("USD")
  // The 20 cost components (§4)
  freight             Float    @default(0)
  fuel                Float    @default(0)
  handling            Float    @default(0)
  terminal            Float    @default(0)
  customs             Float    @default(0)
  broker              Float    @default(0)
  permits             Float    @default(0)
  inspection          Float    @default(0)
  lab                 Float    @default(0)
  insurance           Float    @default(0)
  warehouse           Float    @default(0)
  storage             Float    @default(0)
  demurrage           Float    @default(0)
  detention           Float    @default(0)
  waiting             Float    @default(0)
  specialCargo        Float    @default(0)
  reefer              Float    @default(0)
  dg                  Float    @default(0)
  delivery            Float    @default(0)
  sgtxFee             Float    @default(0)
  // Totals
  totalLandedCost     Float    @default(0)
  // Per-component source (JSON: which provider/quote each component came from)
  costSources         String?  // JSON
  // Breakdown of fixed vs variable
  fixedCost           Float    @default(0)
  variableCost        Float    @default(0)
  // Confidence + notes
  confidence          Float    @default(0.85) // 0..1
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([graphId])
  @@index([legId])
  @@index([quoteId])
}

// --- §5 Transport Documents ---
// 11 document types per the spec. Mode engines remain responsible for
// detailed execution; this is the canonical document registry.
model TransportDocument {
  id                  String   @id @default(cuid())
  ustn                String?
  graphId             String?  // TransportGraph
  legId              String?  // TransportLeg
  documentType        String   // ROAD_WAYBILL | E_CMR | MAWB | HAWB | E_AWB | BILL_OF_LADING | E_BL | RAIL_CONSIGNMENT | FERRY_DOCUMENT | DELIVERY_ORDER | POD
  documentNumber      String?  // the official document number
  issuerGtid          String?  // provider who issued it
  holderGtid         String?  // who holds the document
  // Mode engine link (the mode engine that generated/executed this doc)
  modeEngineRef       String?
  modeEngineType      String?
  // Status
  status              String   @default("DRAFT") // DRAFT | ISSUED | SURRENDERED | RELEASED | AMENDED | CANCELLED | VOID
  issuedAt            DateTime?
  surrenderedAt       DateTime?
  releasedAt          DateTime?
  // Electronic vs paper
  isElectronic        Boolean  @default(true)
  // Content / payload
  payload             String?  // JSON: the document data
  attachments         String?  // JSON array of attachment refs
  // Verification
  verificationHash    String?  // SHA-256 of the document content
  verifiedAt          DateTime?
  verifiedBy         String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([graphId])
  @@index([legId])
  @@index([documentType])
  @@index([status])
  @@index([issuerGtid])
}

// --- §6 Provider Validation ---
// Validates: license, insurance, route authorization, commodity authorization,
// vehicle, driver, terminal authorization, broker license, airline/shipper
// authority. One row per (provider × validation type).
model ProviderValidation {
  id                  String   @id @default(cuid())
  providerGtid        String
  providerType        String   // LSP | FREIGHT_FORWARDER | SHIPPING_LINE | AIRLINE | RAIL_OPERATOR | FERRY | WAREHOUSE | TERMINAL | GHA | CUSTOMS_BROKER | LAB | QC | INSURANCE
  validationType      String   // LICENSE | INSURANCE | ROUTE_AUTHORIZATION | COMMODITY_AUTHORIZATION | VEHICLE | DRIVER | TERMINAL_AUTHORIZATION | BROKER_LICENSE | AIRLINE_SHIPPER_AUTHORITY
  // The validation result
  status              String   @default("PENDING") // PENDING | VALIDATED | INVALID | EXPIRED | NOT_REQUIRED
  // Validation details
  referenceNumber     String?  // license/insurance/permit number
  issuedBy            String?  // issuing authority
  issuedAt            DateTime?
  validFrom           DateTime?
  validUntil          DateTime?
  // Scope of validity
  jurisdictions       String?  // JSON array of jurisdiction codes
  routes              String?  // JSON array of authorized routes
  commodities         String?  // JSON array of authorized commodity codes/HS
  vehicles            String?  // JSON array of authorized vehicle plates
  drivers             String?  // JSON array of authorized driver IDs
  // Verification
  verifiedAt          DateTime?
  verifiedBy          String?
  verificationMethod  String?  // API | PORTAL | DOCUMENT_CHECK | MANUAL
  evidence            String?  // JSON array of evidence refs
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@unique([providerGtid, validationType])
  @@index([providerGtid])
  @@index([providerType])
  @@index([validationType])
  @@index([status])
}

// ===========================================================================
// PHASE 6 — Global Financial & Commercial Execution Fabric (CCL-019)
// 9 engines: Payment · Trade Finance · LC · Documentary Matching · Guarantee
// · Insurance · Accounting · ERP · Reconciliation. Builds ON TOP of the
// existing relationship-based financing model (FinancingRequest /
// FinancingBid / FinancingAgreement / LetterOfCredit) — does NOT change it.
// Financing is permitted ONLY through: trader's connected banks, trader's
// explicitly saved financiers, approved financing entities explicitly
// selected. NOT a random financier marketplace.
// ===========================================================================

// --- §1 Global Payment Engine ---
// Supports 12 payment methods per the spec. Non-custodial (SGTX never holds
// funds — FeeLock pattern). Links to the existing BankSettlementInstruction +
// PaymentAttempt models.
model GlobalPayment {
  id                  String   @id @default(cuid())
  paymentId           String   @unique  // GP-YYYYMMDD-NNNNN
  ustn                String?
  tradeId             String?
  // Payer + payee
  payerGtid           String
  payeeGtid           String
  // Payment method (§1 — 12 methods)
  paymentMethod       String   // BANK_TRANSFER | LOCAL_RAILS | PSP | OPEN_BANKING | SWIFT | ISO_20022 | LOCAL_INSTANT | DOCUMENTARY_COLLECTION | LC | BANK_GUARANTEE | STANDBY | APPROVED_DEFERRED
  // Amount
  amountUsd           Float
  currency            String   @default("USD")
  fxRate              Float?
  amountLocal         Float?
  // Bank/PSP details
  payerBankBic        String?
  payerAccount        String?
  payeeBankBic        String?
  payeeAccount        String?
  pspName             String?
  // Settlement structure (links to existing FeeLock + SettlementInstruction)
  settlementStructure String?
  feeLockId           String?  // existing FeeLock reference
  settlementInstructionId String? // existing SettlementInstruction reference
  // Status
  status              String   @default("PENDING") // PENDING | SUBMITTED | PROCESSING | SETTLED | FAILED | CANCELLED | REVERSED | DUPLICATE
  // Idempotency (§10 duplicate payment detection)
  idempotencyKey      String?
  // Link to existing PaymentAttempt (if created via the legacy flow)
  paymentAttemptId    String?
  // Reconciliation
  reconciliationStatus String? @default("UNRECONCILED") // UNRECONCILED | RECONCILED | DISCREPANT
  reconciliationId    String?
  // Dates
  initiatedAt         DateTime?
  submittedAt         DateTime?
  settledAt           DateTime?
  failedAt            DateTime?
  // Failure
  failureReason       String?
  failureCode         String?
  // Documents
  paymentReference    String?  // bank/PSP reference number
  attachments         String?  // JSON array of doc refs
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([payerGtid])
  @@index([payeeGtid])
  @@index([paymentMethod])
  @@index([status])
  @@index([idempotencyKey])
  @@index([reconciliationStatus])
}

// --- §2 Trade Finance (Phase 6 expanded) ---
// Extends the existing FinancingRequest/FinancingBid/FinancingAgreement model
// (lines 508-635) with Phase 6 lifecycle states. The existing model handles
// the relationship-based RFQ/bid/agreement flow; this Phase 6 model captures
// the expanded lifecycle (financing request → connected-bank → trader-added
// financier → offer → acceptance → disbursement → repayment → guarantee →
// collateral → margin call → settlement).
model TradeFinanceCase {
  id                  String   @id @default(cuid())
  caseId              String   @unique  // TFC-YYYYMMDD-NNNNN
  ustn                String?
  tradeId             String?
  borrowerGtid        String   // the trader seeking financing
  // Relationship-based financing (NON-MARKETPLACE §2)
  // The financier MUST be one of: connected bank, saved financier, approved entity
  financierGtid       String?  // the explicitly-selected financier
  financierType       String?  // CONNECTED_BANK | TRADER_ADDED_FINANCIER | APPROVED_FINANCING_ENTITY
  // Link to existing financing models
  financingRequestId String?  // FinancingRequest.requestId
  financingAgreementId String? // FinancingAgreement.id
  // Amount
  amountUsd           Float
  currency            String   @default("USD")
  tenorDays           Int?
  apr                 Float?
  // Lifecycle status (§2)
  status              String   @default("FINANCING_REQUEST") // FINANCING_REQUEST | CONNECTED_BANK_FINANCING | TRADER_ADDED_FINANCIER | OFFER | ACCEPTANCE | DISBURSEMENT | REPAYMENT | GUARANTEE | COLLATERAL | MARGIN_CALL | SETTLEMENT | CLOSED | REJECTED
  // Collateral
  collateralType      String?  // CASH | GOODS | BANK_GUARANTEE | REAL_ESTATE | NONE
  collateralValueUsd  Float?
  // Disbursement + repayment
  disbursementAmountUsd Float?
  disbursementDate    DateTime?
  repaymentAmountUsd  Float?
  repaymentDate       DateTime?
  // Margin call
  marginCallThreshold Float?
  marginCallTriggered Boolean  @default(false)
  marginCallDate      DateTime?
  // Relationship restriction enforcement
  relationshipVerified Boolean  @default(false) // confirms financier is in the trader's approved list
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([borrowerGtid])
  @@index([financierGtid])
  @@index([status])
}

// --- §3 LC Engine (Phase 6 expanded lifecycle) ---
// The existing LetterOfCredit model (line 3602) captures the LC data.
// This Phase 6 model tracks the expanded 10-step lifecycle:
// application → issuance → advising → confirmation → amendment → presentation →
// discrepancy → acceptance → payment → reimbursement.
model LcLifecycle {
  id                  String   @id @default(cuid())
  ustn                String?
  tradeId             String?
  lcId                String?  // link to existing LetterOfCredit.id
  lcNumber            String?  // link to existing LetterOfCredit.lcNumber
  // Current lifecycle step (§3 — 10 steps)
  currentStep         String   @default("APPLICATION") // APPLICATION | ISSUANCE | ADVISING | CONFIRMATION | AMENDMENT | PRESENTATION | DISCREPANCY | ACCEPTANCE | PAYMENT | REIMBURSEMENT
  status              String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | REJECTED | DISCREPANT
  // Step history (JSON array of { step, status, at, actor, notes })
  stepHistory         String?  // JSON
  // Presentation
  presentationDate   DateTime?
  presentationBankGtid String?
  // Discrepancy
  discrepancies       String?  // JSON array of { type, description, status }
  discrepancyCount    Int      @default(0)
  // Payment + reimbursement
  paymentAmountUsd    Float?
  paymentDate         DateTime?
  reimbursementAmountUsd Float?
  reimbursementDate   DateTime?
  // Parties
  applicantGtid       String?
  beneficiaryGtid     String?
  issuingBankGtid     String?
  advisingBankGtid    String?
  confirmingBankGtid  String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([lcNumber])
  @@index([currentStep])
  @@index([status])
}

// --- §4 Documentary Matching ---
// Match: LC vs Contract vs Invoice vs Packing List vs Transport Document vs
// Certificate vs Customs. Flag discrepancies BEFORE bank presentation.
model DocumentaryMatch {
  id                  String   @id @default(cuid())
  ustn                String?
  tradeId             String?
  lcNumber            String?  // the LC to match against (if LC-based)
  // Documents being matched (JSON array of { type, referenceId, hash })
  documents           String?  // JSON: [{ type: 'LC'|'CONTRACT'|'INVOICE'|'PACKING_LIST'|'TRANSPORT_DOC'|'CERTIFICATE'|'CUSTOMS', referenceId, fields }]
  // Match results
  matchStatus         String   @default("PENDING") // PENDING | MATCHED | DISCREPANT | WAIVED
  discrepancyCount    Int      @default(0)
  discrepancies       String?  // JSON array of { field, docA, docB, valueA, valueB, severity, type }
  // Fields checked (JSON array of field paths checked)
  fieldsChecked       String?  // JSON
  // Confidence
  confidence          Float    @default(0.85) // 0..1
  // Presentation readiness
  readyForPresentation Boolean  @default(false)
  // Review
  reviewedBy          String?
  reviewedAt          DateTime?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([lcNumber])
  @@index([matchStatus])
  @@index([readyForPresentation])
}

// --- §5 Guarantee Engine ---
// 6 guarantee types per the spec. Builds on the existing CustomsBond model
// (line 4267) but extends to the full guarantee family.
model GuaranteeRecord {
  id                  String   @id @default(cuid())
  guaranteeId         String   @unique  // GR-YYYYMMDD-NNNNN
  ustn                String?
  tradeId             String?
  // 6 guarantee types (§5)
  guaranteeType       String   // CUSTOMS_GUARANTEE | BANK_GUARANTEE | TRANSIT_GUARANTEE | DUTY_DEFERRAL | TEMPORARY_ADMISSION | BONDED_WAREHOUSE
  // Issuer + beneficiary
  issuerGtid          String?  // bank/insurance company
  issuerName          String?
  beneficiaryGtid     String?
  beneficiaryName     String?
  // Amount
  amountUsd           Float
  currency            String   @default("USD")
  // Coverage
  coverageScope       String?  // JSON array of covered items
  // Status
  status              String   @default("DRAFT") // DRAFT | ISSUED | ACTIVE | CALLED | EXPIRED | RELEASED | CANCELLED
  issuedAt            DateTime?
  validFrom           DateTime?
  validUntil          DateTime?
  releasedAt          DateTime?
  // Call
  callAmountUsd       Float?
  calledAt            DateTime?
  callReason          String?
  // Link to existing models
  customsBondId       String?  // existing CustomsBond
  bankSettlementId    String?  // existing BankSettlementInstruction
  // Documents
  guaranteeNumber     String?  // official guarantee number
  attachments         String?  // JSON array of doc refs
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([guaranteeType])
  @@index([status])
  @@index([issuerGtid])
  @@index([beneficiaryGtid])
}

// --- §6 Insurance (Phase 6 lifecycle) ---
// The existing InsurancePolicy (line 4974) + InsuranceClaim (line 2865) models
// capture policy + claim data. This Phase 6 model tracks the full 10-step
// lifecycle: QUOTE → BIND → CERTIFICATE → ENDORSEMENT → INCIDENT → CLAIM →
// SURVEY → SETTLEMENT → RECOVERY → CLOSE.
model InsuranceLifecycle {
  id                  String   @id @default(cuid())
  ustn                String?
  tradeId             String?
  // Link to existing models
  policyId            String?  // existing InsurancePolicy.id
  claimId             String?  // existing InsuranceClaim.id
  // Insurance details
  insuranceType       String   // CARGO | MARINE | LIABILITY | PRODUCT | TRADE_CREDIT
  insurerGtid         String?
  insuredGtid         String
  // Amount
  coverageAmountUsd   Float
  premiumUsd          Float
  currency            String   @default("USD")
  // Lifecycle (§6 — 10 steps)
  currentStep         String   @default("QUOTE") // QUOTE | BIND | CERTIFICATE | ENDORSEMENT | INCIDENT | CLAIM | SURVEY | SETTLEMENT | RECOVERY | CLOSE
  status              String   @default("DRAFT") // DRAFT | ACTIVE | INCIDENT | CLAIMED | SETTLED | RECOVERED | CLOSED | REJECTED
  // Step history
  stepHistory         String?  // JSON
  // Incident + claim
  incidentDate        DateTime?
  incidentDescription String?
  claimAmountUsd      Float?
  claimDate           DateTime?
  // Survey
  surveyorGtid        String?
  surveyDate         DateTime?
  surveyResult        String?
  // Settlement + recovery
  settlementAmountUsd Float?
  settlementDate     DateTime?
  recoveryAmountUsd   Float?
  recoveryDate        DateTime?
  // Policy reference
  policyNumber        String?
  certificateNumber  String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([insuranceType])
  @@index([currentStep])
  @@index([status])
  @@index([insurerGtid])
}

// --- §7 Accounting ---
// 12 accounting categories per the spec. One row per accounting entry.
model AccountingEntry {
  id                  String   @id @default(cuid())
  entryId             String   @unique  // AE-YYYYMMDD-NNNNN
  ustn                String?
  tradeId             String?
  // 12 categories (§7)
  category            String   // AP | AR | LANDED_COST | FREIGHT | DUTY | TAX | INSURANCE | ACCRUAL | SETTLEMENT | REFUND | FX | INVENTORY | COGS
  // Double-entry
  debitAccount        String
  creditAccount       String
  amountUsd           Float
  currency            String   @default("USD")
  fxRate              Float?
  amountLocal         Float?
  // Description
  description         String?
  reference           String?  // invoice/BL/customs reference
  // Period
  accountingDate      DateTime
  period              String?  // YYYY-MM
  // Status
  status              String   @default("DRAFT") // DRAFT | POSTED | REVERSED | RECONCILED
  postedAt            DateTime?
  postedBy            String?
  // Link to source
  sourceType          String?  // PAYMENT | INVOICE | CUSTOMS | FREIGHT | MANUAL
  sourceId            String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([category])
  @@index([status])
  @@index([period])
  @@index([accountingDate])
}

// --- §8 ERP Adapter ---
// Adapters for 8 ERP systems per the spec. One row per (trader × ERP) connection.
model ErpAdapter {
  id                  String   @id @default(cuid())
  traderGtid          String
  // 8 ERP types (§8)
  erpType             String   // SAP | ORACLE | MICROSOFT_DYNAMICS | NETSUITE | ODOO | GENERIC_API | GENERIC_EDI | SFTP
  systemName          String?  // custom name
  // Connection
  endpointUrl         String?
  apiKey              String?
  apiSecret           String?
  authMethod          String?  // OAUTH2 | API_KEY | BASIC | MUTUAL_TLS | NONE
  // Status
  status              String   @default("NOT_CONFIGURED") // NOT_CONFIGURED | CONFIGURED | CONNECTED | SYNCING | ERROR | DEPRECATED
  lastSyncAt          DateTime?
  lastSyncStatus      String?  // SUCCESS | PARTIAL | FAILED | NEVER
  lastError           String?
  // Sync config
  syncFrequency       String?  // REAL_TIME | HOURLY | DAILY | WEEKLY
  syncCategories      String?  // JSON array of categories to sync
  // Field mapping (JSON: SGTX field → ERP field)
  fieldMapping        String?  // JSON
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@unique([traderGtid, erpType])
  @@index([traderGtid])
  @@index([erpType])
  @@index([status])
}

// --- §9 Reconciliation ---
// Reconcile: payment, government fee, bank, PSP, carrier, broker, insurance,
// accounting. One row per reconciliation attempt.
model ReconciliationRecord {
  id                  String   @id @default(cuid())
  reconciliationId    String   @unique  // REC-YYYYMMDD-NNNNN
  ustn                String?
  tradeId             String?
  // 8 reconciliation types (§9)
  reconciliationType  String   // PAYMENT | GOVERNMENT_FEE | BANK | PSP | CARRIER | BROKER | INSURANCE | ACCOUNTING
  // Source + target
  sourceType          String   // SGTX record type
  sourceId            String
  targetType          String   // external record type (bank statement, PSP report, etc.)
  targetReference     String?  // bank statement ref, PSP batch ref, etc.
  // Amounts
  sourceAmountUsd     Float
  targetAmountUsd     Float
  differenceUsd       Float    @default(0)
  // Status
  status              String   @default("PENDING") // PENDING | MATCHED | DISCREPANT | UNMATCHED | RESOLVED
  matchedAt           DateTime?
  discrepancyReason   String?
  // Resolution
  resolvedBy          String?
  resolvedAt          DateTime?
  resolutionNotes     String?
  // Period
  reconciliationDate  DateTime
  period              String?  // YYYY-MM
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([reconciliationType])
  @@index([status])
  @@index([period])
}

// --- §2b Financier Relationship (non-marketplace enforcement) ---
// One row per (trader × financier) relationship. A financier can only
// participate if they have a relationship: connected bank, saved financier,
// or approved financing entity. NOT a random marketplace.
model FinancierRelationship {
  id                  String   @id @default(cuid())
  traderGtid          String   // the trader who has the relationship
  financierGtid       String   // the bank/financier GTID
  financierType       String   // CONNECTED_BANK | TRADER_ADDED_FINANCIER | APPROVED_FINANCING_ENTITY
  relationshipStatus  String   @default("ACTIVE") // ACTIVE | INACTIVE | SUSPENDED | EXPIRED
  // Authorization
  authorizedFrom      DateTime?
  authorizedUntil     DateTime?
  authorizedBy        String?
  // Per-trader limits
  creditLimitUsd      Float?
  currentExposureUsd  Float    @default(0)
  // Non-marketplace: NO ranking, NO public score
  internalTrustScore  Int      @default(70)
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@unique([traderGtid, financierGtid])
  @@index([traderGtid])
  @@index([financierGtid])
  @@index([financierType])
  @@index([relationshipStatus])
}

// ===========================================================================
// PHASE 7 — Post-Trade Completion / Returns / Claims / Evidence (CCL-020)
// The trade must NOT end merely at DELIVERY. This phase adds: delivery
// acceptance (DELIVERED → ACCEPTED), claim engine, returns engine,
// post-clearance (customs audit/refund/drawback), final evidence package
// (25-item sealed package), and the USTN_CLOSED final-state gate.
// ===========================================================================

// --- §1 Delivery Acceptance ---
// Records the receiver's acceptance of a delivery. State: DELIVERED → ACCEPTED.
// Requires: receiver, quantity, condition, quality, temperature (where applicable),
// documents, POD, acceptance timestamp.
model DeliveryAcceptance {
  id                  String   @id @default(cuid())
  ustn                String?  // linked trade
  tradeId             String?
  shipmentId          String?
  // Receiver
  receiverGtid        String?
  receiverName        String?
  receiverSignature   String?  // signature reference/hash
  // Acceptance details
  quantityDelivered   Float?
  quantityUnit        String?
  quantityAccepted    Float?
  quantityRejected    Float?
  condition           String   @default("GOOD") // GOOD | DAMAGED | PARTIAL | CONTAMINATED | OTHER
  conditionNotes      String?
  quality             String   @default("ACCEPTABLE") // ACCEPTABLE | REJECTED | CONDITIONAL
  qualityNotes        String?
  temperatureMinC     Float?
  temperatureMaxC     Float?
  temperatureActualC  Float?
  temperatureCompliant Boolean?
  // Documents
  podReference        String?  // Proof of Delivery reference
  documents          String?  // JSON array of { type, reference, hash }
  photos              String?  // JSON array of photo refs
  // State
  status              String   @default("DELIVERED") // DELIVERED | ACCEPTED | REJECTED | PARTIAL_ACCEPTANCE
  acceptanceTimestamp DateTime?
  rejectionReason     String?
  // Location
  deliveryLocation    String?  // UN/LOCODE or address
  deliveryLat         Float?
  deliveryLng         Float?
  // Link to claims (if goods rejected → claim opened)
  claimId             String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([receiverGtid])
  @@index([status])
  @@index([acceptanceTimestamp])
}

// --- §2 Claim Engine ---
// 10 claim types per the spec. All evidence linked to USTN.
model TradeClaim {
  id                  String   @id @default(cuid())
  claimId             String   @unique  // CLM-YYYYMMDD-NNNNN
  ustn                String?  // linked trade
  tradeId             String?
  // Parent/child USTN relationship (for returns — §3)
  parentUstn          String?  // the original trade USTN (if this is a return/child)
  // Claim details
  claimType           String   // SHORTAGE | DAMAGE | QUALITY | TEMPERATURE | DELAY | CUSTOMS | DOCUMENTATION | LOGISTICS | INSURANCE | WARRANTY
  claimSeverity       String   @default("MINOR") // MINOR | MAJOR | CRITICAL
  claimDescription    String?
  // Amount
  claimedAmountUsd    Float?
  claimedAmountLocal  Float?
  currency            String   @default("USD")
  // Parties
  claimantGtid        String?  // who filed the claim
  respondentGtid      String?  // who the claim is against
  // Evidence
  evidence            String?  // JSON array of { type, reference, hash, uploadedAt }
  // Status
  status              String   @default("OPEN") // OPEN | UNDER_REVIEW | ACCEPTED | REJECTED | RESOLVED | ESCALATED | WITHDRAWN
  resolutionAmountUsd Float?
  resolutionNotes     String?
  // Linkage
  deliveryAcceptanceId String? // the delivery that triggered the claim
  returnId            String?  // the return record (if a return is opened)
  insuranceClaimId    String?  // the insurance lifecycle (if insurance claim)
  // Dates
  filedAt             DateTime?
  reviewedAt          DateTime?
  resolvedAt          DateTime?
  closedAt            DateTime?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([parentUstn])
  @@index([claimType])
  @@index([status])
  @@index([claimantGtid])
  @@index([respondentGtid])
}

// --- §3 Returns Engine ---
// 8 return types per the spec. Preserves full parent/child USTN relationship.
model ReturnRecord {
  id                  String   @id @default(cuid())
  returnId            String   @unique  // RET-YYYYMMDD-NNNNN
  ustn                String?  // the NEW trade USTN (child) for this return
  parentUstn          String?  // the ORIGINAL trade USTN (parent)
  parentTradeId       String?
  // 8 return types (§3)
  returnType          String   // REJECTION | RETURN | REPAIR | REPLACEMENT | RE_EXPORT | RE_IMPORT | WARRANTY | DESTRUCTION | ABANDONMENT
  reason              String?
  // Goods
  quantityReturned    Float?
  quantityUnit        String?
  goodsCondition      String   @default("GOOD") // GOOD | DAMAGED | DEFECTIVE | CONTAMINATED
  // Logistics
  returnOrigin        String?  // where goods are being returned from
  returnDestination   String?  // where goods are going
  transportMode       String?  // ROAD | AIR | OCEAN | RAIL | FERRY
  // Customs
  reExportDeclaration String?  // customs declaration number (if re-export)
  reImportDeclaration String?  // customs declaration number (if re-import)
  // Status
  status              String   @default("OPEN") // OPEN | IN_TRANSIT | RECEIVED | PROCESSED | COMPLETED | CANCELLED
  // Linkage
  claimId             String?  // the claim that triggered the return
  deliveryAcceptanceId String? // the delivery that triggered the return
  // Dates
  initiatedAt         DateTime?
  shippedAt           DateTime?
  receivedAt          DateTime?
  completedAt         DateTime?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([parentUstn])
  @@index([returnType])
  @@index([status])
}

// --- §4 Post-Clearance ---
// 9 post-clearance action types per the spec.
model PostClearanceAction {
  id                  String   @id @default(cuid())
  actionId            String   @unique  // PCA-YYYYMMDD-NNNNN
  ustn                String?  // linked trade
  tradeId             String?
  customsOperationId  String?  // link to CustomsOperationV2
  // 9 action types (§4)
  actionType          String   // CUSTOMS_AUDIT | CUSTOMS_QUERY | CORRECTION | REASSESSMENT | REFUND | DRAWBACK | PENALTY | APPEAL | RECORD_RETRIEVAL
  // Details
  description         String?
  customsAuthority    String?
  customsReference    String?  // customs reference number
  // Amount
  amountUsd           Float?
  currency            String   @default("USD")
  // Status
  status              String   @default("OPEN") // OPEN | IN_REVIEW | APPROVED | REJECTED | COMPLETED | PENDING_PAYMENT | PAID
  resolution          String?
  resolutionNotes     String?
  // Dates
  filedAt             DateTime?
  reviewedAt          DateTime?
  resolvedAt          DateTime?
  // Linkage
  accountingEntryId   String?  // link to the accounting entry
  reconciliationId    String?  // link to the reconciliation record
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([customsOperationId])
  @@index([actionType])
  @@index([status])
}

// --- §5 Final Evidence Package ---
// The sealed 25-item evidence package created at trade completion.
model FinalEvidencePackage {
  id                  String   @id @default(cuid())
  packageId           String   @unique  // FEP-YYYYMMDD-NNNNN
  ustn                String?  // linked trade
  tradeId             String?
  // The 25 evidence sections (§5) — each is a JSON array of evidence items
  rfq                 String?  // JSON array of RFQ evidence
  quotation           String?  // JSON array of quotation evidence
  purchaseOrder       String?  // JSON array of PO evidence
  contract            String?  // JSON array of contract evidence
  invoice             String?  // JSON array of invoice evidence
  packingList         String?  // JSON array of packing list evidence
  licenses            String?  // JSON array of license evidence
  permits             String?  // JSON array of permit evidence
  certificates        String?  // JSON array of certificate evidence
  customs             String?  // JSON array of customs evidence
  transport           String?  // JSON array of transport evidence
  gps                 String?  // JSON array of GPS evidence
  iot                 String?  // JSON array of IoT evidence
  inspection          String?  // JSON array of inspection evidence
  qc                  String?  // JSON array of QC evidence
  governmentReferences String? // JSON array of government references
  payment             String?  // JSON array of payment evidence
  bankConfirmation    String?  // JSON array of bank confirmation evidence
  settlement          String?  // JSON array of settlement evidence
  accounting          String?  // JSON array of accounting evidence
  delivery            String?  // JSON array of delivery evidence
  claims              String?  // JSON array of claims evidence
  disputes            String?  // JSON array of disputes evidence
  communications      String?  // JSON array of communications evidence
  governorDecisions   String?  // JSON array of Governor decision evidence
  loomChain           String?  // JSON array of Loom chain evidence
  // Seal
  packageHash         String?  // SHA-256 of the full package
  sealedAt            DateTime?
  sealedBy            String?
  // Status
  status              String   @default("DRAFT") // DRAFT | SEALED | AMENDED | ARCHIVED
  completenessScore   Float    @default(0) // 0..1 — fraction of the 25 sections populated
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([status])
  @@index([sealedAt])
}

// --- §6 Final Trade State (USTN_CLOSED gate) ---
// Tracks the 7 closure conditions. USTN_CLOSED is only set when ALL conditions pass.
model TradeClosureState {
  id                  String   @id @default(cuid())
  ustn                String   @unique  // one closure state per trade
  tradeId             String?
  // The 7 closure conditions (§6)
  deliveryAccepted    Boolean  @default(false)
  settlementComplete  Boolean  @default(false)
  financialReconciliationComplete Boolean @default(false)
  activeCustomsObligationsComplete Boolean @default(false)
  requiredPostClearanceObligationsComplete Boolean @default(false)
  disputeClaimStateResolved Boolean @default(false) // true if no OPEN disputes OR formally open
  evidencePackageSealed Boolean @default(false)
  evidencePackageId   String?  // link to FinalEvidencePackage
  // Final state
  closureState        String   @default("OPEN") // OPEN | READY_FOR_CLOSURE | USTN_CLOSED | USTN_CLOSED_WITH_OPEN_DISPUTE
  closedAt            DateTime?
  closedBy            String?
  // Summary
  closureChecklist    String?  // JSON array of { condition, met, notes }
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([closureState])
}

// ===========================================================================
// PHASE 8 — Worldwide Integration Catalog + Global Integration Gap Control
// (CCL-021) SGTX must always know: "What external system is required for
// this trade, whether it exists, whether it is connected, and exactly what
// is missing." Builds ON TOP of the Phase 4 GovConnector model (which is
// RETAINED) — this catalog is the worldwide discovery layer.
// ===========================================================================

// --- §1 Global Integration Catalog ---
// Each connector = one (jurisdiction × authority × system × procedure ×
// transport_mode) tuple. Richer than the Phase 4 GovConnector (which is
// the per-connection record). This catalog is the worldwide "what exists"
// registry.
model IntegrationCatalog {
  id                  String   @id @default(cuid())
  connectorId         String   @unique  // CAT-YYYYMMDD-NNNNN
  jurisdictionCode    String   // ISO alpha-2 or customs territory code
  authority           String   // CUSTOMS | TAX | SPS | TBT | AGRICULTURE | HEALTH | STANDARDS | SECURITY | TRANSPORT | BANK | INSURANCE | BROKER | ERP
  systemName          String   // e.g. "Nafeza", "CargoX", "ETA", "CBP ACE"
  procedure           String?  // e.g. "IMPORT", "EXPORT", "TRANSIT", "REFUND"
  transportMode       String?  // ROAD | AIR | OCEAN | RAIL | FERRY | MULTIMODAL | null=all
  // §2 integration type (13 types)
  integrationType     String   // API | EDI | XML | JSON | UN_EDIFACT | CARGO_XML | ONE_RECORD | ISO_20022 | SFTP | WEBHOOK | PORTAL | BROKER | MANUAL
  purpose             String?  // human-readable purpose
  // URLs
  officialUrl         String?
  apiUrl              String?
  ediUrl              String?
  portalUrl           String?
  documentationUrl    String?
  sandboxUrl          String?
  // Auth + certification
  authentication      String?  // OAUTH2 | API_KEY | MUTUAL_TLS | BASIC | NONE | CERTIFICATE
  certificateRequirement String?
  legalAgreement      String?
  certification       String?  // REQUIRED | PENDING | GRANTED | EXPIRED | NOT_REQUIRED
  productionRequirements String? // JSON array of requirements
  // §3 connector status (16-state lifecycle)
  status              String   @default("NOT_DISCOVERED") // NOT_DISCOVERED | DISCOVERED | DOCUMENTED | CONTACT_REQUIRED | CREDENTIALS_REQUIRED | SANDBOX_AVAILABLE | SANDBOX_CONNECTED | CERTIFICATION_REQUIRED | CERTIFICATION_PENDING | PRODUCTION_READY | PRODUCTION_CONNECTED | DEGRADED | OUTAGE | PORTAL_ONLY | MANUAL_ONLY | DEPRECATED
  // Metadata
  priority            Int      @default(50) // 0..100
  owner              String?  // responsible team
  lastVerifiedAt     DateTime?
  version            String?  // API/schema version
  notes              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@unique([jurisdictionCode, authority, systemName, procedure, transportMode, integrationType])
  @@index([jurisdictionCode])
  @@index([authority])
  @@index([systemName])
  @@index([status])
  @@index([integrationType])
  @@index([transportMode])
}

// --- §4 Integration Gap Record ---
// For each (jurisdiction × authority × procedure × transport_mode) required
// by a trade, this records whether the integration is available + connected
// or what's missing.
model IntegrationGapRecord {
  id                  String   @id @default(cuid())
  gapId               String   @unique  // GAP-YYYYMMDD-NNNNN
  jurisdictionCode    String
  authority           String
  procedure           String?
  transportMode       String?
  systemName          String?
  // Required?
  required            Boolean  @default(true)
  // Availability per type
  apiAvailable        Boolean  @default(false)
  ediAvailable        Boolean  @default(false)
  portalAvailable     Boolean  @default(false)
  documentationAvailable Boolean @default(false)
  // Requirements
  credentialsRequired Boolean  @default(false)
  sandboxRequired     Boolean  @default(false)
  certificationRequired Boolean @default(false)
  legalAgreementRequired Boolean @default(false)
  // Status + priority
  status              String   @default("MISSING") // CONNECTED | PARTIAL | MANUAL | MISSING | DEPRECATED
  priority            Int      @default(50) // 0..100
  // Impact
  affectedTradeLanes  String?  // JSON array of trade lane ids
  affectedUstns       String?  // JSON array of USTNs
  // Ownership + action
  owner              String?
  nextAction         String?
  dueDate            DateTime?
  // Source + evidence
  source             String?  // AUTOMATIC_DISCOVERY | MANUAL | GOVERNMENT_NOTIFICATION
  evidence           String?  // JSON array of evidence refs
  notes              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([jurisdictionCode])
  @@index([authority])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
}

// --- §8 Country Trade Readiness ---
// One row per (country × readiness_dimension). Dimensions: Customs, Tax,
// SPS, TBT, Licenses, Permits, Certificates, Transport, Security, Payment,
// Insurance, Broker, ERP, Accounting, Government APIs.
model CountryReadiness {
  id                  String   @id @default(cuid())
  countryCode         String   // ISO alpha-2
  countryName         String?
  dimension           String   // CUSTOMS | TAX | SPS | TBT | LICENSES | PERMITS | CERTIFICATES | TRANSPORT | SECURITY | PAYMENT | INSURANCE | BROKER | ERP | ACCOUNTING | GOVERNMENT_APIS
  // Readiness level (§8)
  readinessLevel      String   @default("MISSING") // CONNECTED | PARTIAL | MANUAL | MISSING
  // Details
  connectedCount      Int      @default(0)
  partialCount        Int      @default(0)
  manualCount         Int      @default(0)
  missingCount        Int      @default(0)
  readinessScore      Float    @default(0) // 0..1 — weighted by connected/partial
  // Metadata
  lastAssessedAt      DateTime?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@unique([countryCode, dimension])
  @@index([countryCode])
  @@index([dimension])
  @@index([readinessLevel])
}

// --- §9 Trade Lane Readiness ---
// For each (origin → destination → transit → commodity → HS → mode), the
// regulatory + document + customs + transport + government readiness.
model TradeLaneReadiness {
  id                  String   @id @default(cuid())
  laneId              String   @unique  // TLR-YYYYMMDD-NNNNN
  // Lane definition
  originCountry       String
  destinationCountry  String
  transitCountries    String?  // JSON array of ISO alpha-2
  commodity           String?
  hs6                 String?
  transportMode       String?
  // Readiness dimensions (§9)
  regulatoryReadiness String   @default("MISSING") // CONNECTED | PARTIAL | MANUAL | MISSING
  documentReadiness   String   @default("MISSING")
  customsReadiness    String   @default("MISSING")
  transportReadiness  String   @default("MISSING")
  governmentConnectivity String @default("MISSING")
  // Details
  manualTouchpoints   Int      @default(0)
  missingIntegrations Int      @default(0)
  blockers            String?  // JSON array of blocker descriptions
  overallReadiness    Float    @default(0) // 0..1
  // Metadata
  lastAssessedAt      DateTime?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([originCountry, destinationCountry])
  @@index([transportMode])
  @@index([hs6])
  @@index([overallReadiness])
}

// --- §10 Integration Alerts ---
// Alert admin when: cert expires, API expires, credential expires,
// government schema changes, connector outage, country law changes,
// required integration missing, trade lane non-ready, connector deprecated.
model IntegrationAlert {
  id                  String   @id @default(cuid())
  alertId             String   @unique  // ALT-YYYYMMDD-NNNNN
  alertType           String   // CERTIFICATE_EXPIRES | API_EXPIRES | CREDENTIAL_EXPIRES | SCHEMA_CHANGES | CONNECTOR_OUTAGE | COUNTRY_LAW_CHANGES | REQUIRED_MISSING | LANE_NON_READY | CONNECTOR_DEPRECATED
  severity            String   @default("WARN") // INFO | WARN | CRITICAL
  // Target
  jurisdictionCode    String?
  authority           String?
  systemName          String?
  connectorId         String?  // IntegrationCatalog.connectorId
  laneId             String?  // TradeLaneReadiness.laneId (for LANE_NON_READY)
  // Message
  title               String
  description         String?
  // Action
  actionRequired     String?
  dueDate            DateTime?
  // Status
  status              String   @default("OPEN") // OPEN | ACKNOWLEDGED | RESOLVED | DISMISSED
  acknowledgedBy      String?
  acknowledgedAt      DateTime?
  resolvedBy         String?
  resolvedAt         DateTime?
  resolutionNotes    String?
  // Impact
  affectedUstns      String?  // JSON array of affected USTNs
  // Metadata
  source             String?  // AUTOMATIC | MANUAL | GOVERNMENT_NOTIFICATION
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([alertType])
  @@index([severity])
  @@index([status])
  @@index([jurisdictionCode])
  @@index([connectorId])
  @@index([dueDate])
}

// ===========================================================================
// PHASE 9 — Worldwide Country Activation + Regulatory Change Management
// (CCL-022) Two engines: (1) country activation workflow (20 steps from
// jurisdiction selection → Loom record), (2) regulatory change management
// with impact engine + 7-step approval pipeline. Existing locked trades
// retain their regulatory snapshot; future trades use the new version.
// ===========================================================================

// --- §1 Country Activation Workflow ---
// The 20-step activation workflow for bringing a new country live on SGTX.
model CountryActivationWorkflow {
  id                  String   @id @default(cuid())
  workflowId          String   @unique  // CAW-YYYYMMDD-NNNNN
  countryCode         String   // ISO alpha-2
  countryName         String?
  // The 20 steps (§1)
  currentStep         Int      @default(1) // 1-20
  step1JurisdictionSelected   Boolean @default(false)
  step2OfficialSourcesLoaded  Boolean @default(false)
  step3CustomsProfileConfigured Boolean @default(false)
  step4TaxConfigured          Boolean @default(false)
  step5SpsConfigured         Boolean @default(false)
  step6TbtConfigured          Boolean @default(false)
  step7LicensingConfigured   Boolean @default(false)
  step8TransportConfigured   Boolean @default(false)
  step9CustomsSystemsIdentified Boolean @default(false)
  step10ApisIdentified       Boolean @default(false)
  step11EdiIdentified        Boolean @default(false)
  step12PortalsIdentified    Boolean @default(false)
  step13ManualProceduresIdentified Boolean @default(false)
  step14CredentialsEntered   Boolean @default(false)
  step15SandboxConnection    Boolean @default(false)
  step16ConformanceTesting  Boolean @default(false)
  step17LegalRegulatoryReview Boolean @default(false)
  step18ProductionApproval   Boolean @default(false)
  step19Activation           Boolean @default(false)
  step20LoomRecord           Boolean @default(false)
  // Step history (JSON array of { step, completedAt, completedBy, notes })
  stepHistory         String?  // JSON
  // Status
  status              String   @default("IN_PROGRESS") // IN_PROGRESS | ACTIVATED | SUSPENDED | BLOCKED | CANCELLED
  activatedAt         DateTime?
  // Ownership
  owner              String?
  // Loom
  loomHash            String?  // SHA-256 of the activation record
  // Metadata
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([countryCode])
  @@index([status])
  @@index([currentStep])
}

// --- §2-3 Regulatory Change + Impact ---
// A regulatory change detected by RIA (or manual entry). The change has an
// impact assessment (affected products/countries/modes/lanes/USTNs/documents/
// policies/integrations) + a 7-step approval pipeline.
model RegulatoryChangeV2 {
  id                  String   @id @default(cuid())
  changeId            String   @unique  // RCG-YYYYMMDD-NNNNN
  // What changed (§2 — 12 monitoring categories)
  changeCategory      String   // LAW | REGULATION | CUSTOMS_PROCEDURE | TAX | TARIFF | SANCTIONS | SPS | TBT | LICENSES | PERMITS | GOVERNMENT_APIS | DOCUMENT_REQUIREMENTS
  changeType          String   // NEW | AMENDED | REPEALED | SUSPENDED | REPLACED
  title               String
  description         String?
  // Source
  sourceAuthority     String?
  sourceUrl           String?
  sourceReference     String?  // official gazette / law number
  detectedBy          String   @default("RIA") // RIA | MANUAL | GOVERNMENT_NOTIFICATION
  // Jurisdiction
  jurisdictionCode    String   // the country/customs territory affected
  // Effective dates
  announcedDate       DateTime?
  effectiveDate       DateTime?
  expiryDate          DateTime?
  // Impact (§3)
  affectedProducts    String?  // JSON array of HS6 codes
  affectedCountries   String?  // JSON array of country codes
  affectedModes       String?  // JSON array of transport modes
  affectedTradeLanes  String?  // JSON array of lane IDs
  affectedActiveUstns String?  // JSON array of active USTNs
  affectedDocuments   String?  // JSON array of document types
  affectedPolicies    String?  // JSON array of policy IDs
  affectedIntegrations String? // JSON array of connector IDs
  impactSummary       String?  // human-readable impact summary
  impactSeverity      String   @default("MINOR") // MINOR | MODERATE | MAJOR | CRITICAL
  // §5 Trade Snapshot: existing locked trades retain their original snapshot;
  // future trades use the new version.
  snapshotPolicy      String   @default("PRESERVE_EXISTING") // PRESERVE_EXISTING | RETROACTIVE | TRANSITIONAL
  // Approval pipeline (§4)
  pipelineStatus      String   @default("DETECTED") // DETECTED | VERIFIED | IMPACTED | SIMULATED | APPROVED | COMPILED | DEPLOYED | REJECTED | ROLLED_BACK
  pipelineHistory     String?  // JSON array of { status, at, actor, notes }
  // Governor/multisig (§4 — for constitutional policy changes)
  governorDecision    String?  // Governor decision ID
  multisigApproval   String?  // multisig approval reference
  // Deployment
  deployedAt          DateTime?
  deploymentNotes     String?
  // Rollback
  rollbackSupported   Boolean  @default(true)
  rolledBackAt        DateTime?
  rollbackReason      String?
  // Metadata
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([changeCategory])
  @@index([jurisdictionCode])
  @@index([pipelineStatus])
  @@index([impactSeverity])
  @@index([effectiveDate])
}

// --- §4 Change Approval Pipeline Steps ---
// One row per pipeline step per change. Tracks the 7-step pipeline:
// DETECTED → VERIFIED → IMPACTED → SIMULATED → APPROVED → COMPILED → DEPLOYED.
model ChangePipelineStep {
  id                  String   @id @default(cuid())
  changeId            String   // RegulatoryChangeV2.changeId
  stepName            String   // DETECTED | VERIFIED | IMPACTED | SIMULATED | APPROVED | COMPILED | DEPLOYED
  stepOrder           Int      // 1-7
  status              String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | REJECTED | SKIPPED
  // Actor
  actor               String?  // who performed the step
  // Result
  resultSummary       String?
  resultData          String?  // JSON: step-specific data (e.g. simulation results, impact assessment)
  // Governor/multisig (for APPROVED step on constitutional changes)
  governorDecisionId  String?
  multisigRef         String?
  // Dates
  startedAt           DateTime?
  completedAt         DateTime?
  // Notes
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@unique([changeId, stepName])
  @@index([changeId])
  @@index([stepName])
  @@index([status])
}

// --- §5 Trade Snapshot Version ---
// Each regulatory change creates a new snapshot version. Existing locked
// trades retain their original version; future trades use the new version.
model RegulatorySnapshotVersion {
  id                  String   @id @default(cuid())
  versionId           String   @unique  // RSV-YYYYMMDD-NNNNN
  changeId            String?  // the RegulatoryChangeV2 that created this version
  jurisdictionCode    String
  versionNumber       Int      @default(1)
  // Snapshot content (JSON: the full regulatory state at this version)
  snapshotContent     String?  // JSON: tariff rates, document requirements, SPS rules, etc.
  snapshotHash        String?  // SHA-256 of the content
  // Affected trades
  activeTradesUsingThisVersion Int  @default(0) // count of active USTNs on this version
  // Status
  status              String   @default("ACTIVE") // ACTIVE | SUPERSEDED | ARCHIVED
  supersededByVersion String?  // the versionId that superseded this one
  // Metadata
  effectiveDate       DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([jurisdictionCode])
  @@index([changeId])
  @@index([versionNumber])
  @@index([status])
}

// ===========================================================================
// PHASE 10 — Global End-to-End Integration, Reconciliation & Production
// Readiness (CCL-023) — THE FINAL INTEGRATION PHASE.
// Does NOT add new major architecture. Integrates everything from Phases
// 1-9 into a single verification + reporting layer. Two models only:
// (1) E2ETradeGraphValidation — the result of running the 23-step trade
// graph validation, (2) ProductionReadinessReport — the final readiness
// report aggregating all checks with CORRECT TERMINOLOGY (§12).
// ===========================================================================

// --- §1 E2E Trade Graph Validation ---
// The 23-step trade lifecycle: Trade → Order → Contract → Regulatory →
// Documents → Licenses → Permits → Certificates → Booking → Export Customs →
// Transport → Transit → Import Customs → Tax → Release → Delivery →
// Acceptance → Settlement → Accounting → Claims → Post-Clearance →
// Evidence → USTN CLOSED.
model E2ETradeGraphValidation {
  id                  String   @id @default(cuid())
  validationId       String   @unique  // E2E-YYYYMMDD-NNNNN
  ustn                String?  // the trade being validated
  tradeId             String?
  // The 23 steps (§1)
  step1Trade              Boolean @default(false)
  step2Order              Boolean @default(false)
  step3Contract           Boolean @default(false)
  step4Regulatory         Boolean @default(false)
  step5Documents          Boolean @default(false)
  step6Licenses           Boolean @default(false)
  step7Permits            Boolean @default(false)
  step8Certificates       Boolean @default(false)
  step9Booking            Boolean @default(false)
  step10ExportCustoms     Boolean @default(false)
  step11Transport         Boolean @default(false)
  step12Transit           Boolean @default(false)
  step13ImportCustoms     Boolean @default(false)
  step14Tax               Boolean @default(false)
  step15Release           Boolean @default(false)
  step16Delivery          Boolean @default(false)
  step17Acceptance        Boolean @default(false)
  step18Settlement        Boolean @default(false)
  step19Accounting        Boolean @default(false)
  step20Claims            Boolean @default(false)
  step21PostClearance     Boolean @default(false)
  step22Evidence          Boolean @default(false)
  step23UstnClosed        Boolean @default(false)
  // Validation result
  status              String   @default("PENDING") // PENDING | IN_PROGRESS | PASSED | FAILED | PARTIAL
  completedSteps      Int      @default(0)
  totalSteps          Int      @default(23)
  failedSteps         String?  // JSON array of { step, reason }
  // Transport mode (§2)
  transportMode       String?  // ROAD | AIR | OCEAN | RAIL | FERRY | MULTIMODAL
  multimodalLegs      String?  // JSON array of leg modes (for multimodal tests)
  // Countries
  originCountry       String?
  destinationCountry  String?
  transitCountries    String?  // JSON array
  // Metadata
  startedAt           DateTime?
  completedAt         DateTime?
  duration            Int?     // milliseconds
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([status])
  @@index([transportMode])
}

// --- §11 Production Readiness Report ---
// The final GLOBAL SGTX TRADE EXECUTION READINESS REPORT. Uses CORRECT
// TERMINOLOGY (§12): CORE READY / ADAPTER READY / COUNTRY CONFIGURED /
// SANDBOX CONNECTED / PRODUCTION CONNECTED / MANUAL ONLY / PORTAL ONLY /
// INTEGRATION REQUIRED. Does NOT claim "WORLDWIDE INTEGRATED" unless every
// individual connector is operational.
model ProductionReadinessReport {
  id                  String   @id @default(cuid())
  reportId            String   @unique  // PRR-YYYYMMDD-NNNNN
  // Report sections (§11)
  implementedModules  String?  // JSON array of module names
  activeJurisdictions String?  // JSON array of { countryCode, readinessLevel }
  inactiveJurisdictions String? // JSON array
  activeConnectors    String?  // JSON array of connector IDs
  missingConnectors   String?  // JSON array
  sandboxConnectors   String?  // JSON array
  portalOnlyIntegrations String? // JSON array
  manualOnlyIntegrations String? // JSON array
  governmentApprovalsRequired String? // JSON
  credentialsRequired String?  // JSON
  certificationsRequired String? // JSON
  legalAgreementsRequired String? // JSON
  transportIntegrations String? // JSON
  bankIntegrations    String?  // JSON
  erpIntegrations     String?  // JSON
  insuranceIntegrations String? // JSON
  customsIntegrations String?  // JSON
  taxIntegrations     String?  // JSON
  spsTbtIntegrations  String?  // JSON
  outstandingBlockers String?  // JSON array of blocker descriptions
  testResults         String?  // JSON: { e2e, multimodal, country, government, financial, data, security, governor, loom }
  securityResults     String?  // JSON: { dependencyAudit, apiSecurity, rbac, rls, tenantIsolation, secrets, certValidation, signatureValidation, replayProtection, idempotency, auditIntegrity }
  deploymentResults   String?  // JSON
  // Summary
  overallReadiness    String   @default("INTEGRATION_REQUIRED") // CORE_READY | ADAPTER_READY | COUNTRY_CONFIGURED | SANDBOX_CONNECTED | PRODUCTION_CONNECTED | MANUAL_ONLY | PORTAL_ONLY | INTEGRATION_REQUIRED
  readinessScore     Float    @default(0) // 0..1
  // §12 terminology
  terminology         String   @default("CORRECT") // CORRECT — never claim "WORLDWIDE INTEGRATED" unless every connector is operational
  // Metadata
  generatedAt        DateTime @default(now())
  generatedBy        String?
  notes              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([reportId])
  @@index([overallReadiness])
  @@index([generatedAt])
}

// ===========================================================================
// SGTX MASTER CONSTITUTIONAL AMENDMENT — Multi-Clock State, Event Integrity,
// Settlement Orchestration, Reconciliation, Exception, Recovery, Evidence,
// Financial Exposure (CCL-024)
// Implements: §6 Multi-Clock, §7 State Vector, §12 Event Spine, §15 Event
// Causality, §37 Bank Settlement Gateway, §45 Payment Leg Model, §63
// Financial Exposure Engine, §66 Obligation Graph, §69 Causal Impact,
// §70 Exception Engine, §89 Transaction Twin, §91 Recovery Vault, §56 Bank
// Reference Mapping, §57 External Identifier Registry.
// ===========================================================================

// --- §7 State Vector — multi-dimensional transaction reality ---
model TransactionStateVector {
  id                  String   @id @default(cuid())
  ustn                String   @unique
  // §6 Multi-Clock domains (§8 — 12 domains)
  execution           String   @default("PENDING")
  financial           String   @default("PENDING")
  legal               String   @default("PENDING")
  physicalOperational String   @default("PENDING")
  documentary         String   @default("PENDING")
  compliance          String   @default("PENDING")
  regulatory          String   @default("PENDING")
  counterparty        String   @default("PENDING")
  reconciliation      String   @default("PENDING")
  dispute             String   @default("NONE")
  exposure            String   @default("NONE")
  closure             String   @default("OPEN")
  // Finality classes (§9 — F0-F5)
  finalityClass       String   @default("F0")
  // Divergence + health metrics (§95-98)
  stateIntegrityScore Float?   // 0..1
  reconciliationConfidence Float? // 0..100
  divergenceIndex      String?  // NONE | LOW | MEDIUM | HIGH | CRITICAL
  transactionHealth   String?  // GREEN | YELLOW | ORANGE | RED | BLACK
  // Metadata
  lastUpdated         DateTime @default(now()) @updatedAt
  createdAt           DateTime @default(now())

  @@index([ustn])
  @@index([closure])
  @@index([exposure])
}

// --- §12 Immutable Canonical Event Spine ---
model CanonicalEvent {
  id                  String   @id @default(cuid())
  eventId             String   @unique
  ustn                String?  // linked trade
  parentEventId       String?  // §15 event causality
  // Event classification
  eventType           String   // TRADE_CREATED | CONTRACT_SIGNED | PAYMENT_SETTLED | etc.
  eventTypeCategory   String   // OBSERVATION | ASSERTION | CONFIRMATION | COMMAND (§159.1, §159.2)
  // §16 Three Timestamps
  eventTime           DateTime  // when it actually occurred
  observationTime     DateTime  // when SGTX learned/received it
  effectiveTime       DateTime? // when it became legally/operationally effective
  // Source + authority
  sourceSystem        String?
  sourceEventId       String?
  sourceReference     String?
  authority           String?  // SGTX | BANK | CUSTOMS | COURT | etc.
  // Evidence + hash chain (§15)
  evidenceReference   String?  // JSON array of evidence refs
  previousEventHash   String?
  eventHash           String?  // SHA-256
  // Policy
  policyVersion       String?
  // Actor + authorization
  actor               String?
  authorizationContext String?  // JSON
  // Idempotency (§18)
  idempotencyKey      String?
  // Status
  status              String   @default("RECORDED") // RECORDED | PROVISIONAL | SUPERSEDED | REJECTED
  notes               String?
  createdAt           DateTime @default(now())

  @@index([ustn])
  @@index([eventType])
  @@index([eventTime])
  @@index([idempotencyKey])
  @@index([parentEventId])
}

// --- §89 Transaction Twin ---
model TransactionTwin {
  id                  String   @id @default(cuid())
  ustn                String   @unique
  // State vector reference
  stateVectorId       String?
  // All domains represented (§89)
  obligations         String?  // JSON array of obligation IDs
  actors              String?  // JSON array of actor GTIDs
  dependencies       String?  // JSON dependency graph
  documents           String?  // JSON document set
  financialState      String?  // JSON financial state
  legalState          String?
  executionState      String?
  physicalState       String?
  complianceState    String?
  evidence            String?  // JSON evidence references
  exceptions          String?  // JSON exception IDs
  exposure           String?  // JSON exposure summary
  recoveryPaths       String?  // JSON recovery path IDs
  closureConditions   String?  // JSON closure conditions
  // Post-closure observation (§22)
  postClosurePeriod   String?  // jurisdiction-specific period
  postClosureActive   Boolean  @default(false)
  // Metadata
  lastUpdated         DateTime @default(now()) @updatedAt
  createdAt           DateTime @default(now())

  @@index([ustn])
}

// --- §45 Payment Leg Model ---
model PaymentLeg {
  id                  String   @id @default(cuid())
  legId               String   @unique
  ustn                String
  settlementInstructionId String?
  // Leg details (§44)
  beneficiaryId       String?
  beneficiaryName     String?
  beneficiaryType     String?  // SELLER | LOGISTICS | CUSTOMS | LABORATORY | BROKER | SGTX_FEE
  amount              Float
  currency            String   @default("USD")
  // Bank reference (§56)
  bankInstructionId   String?
  bankTransactionRef  String?
  externalPaymentRef  String?
  // Leg state (§140)
  legState            String   @default("PENDING") // PENDING | AUTHORIZED | SUBMITTED | PROCESSING | SETTLED | PARTIALLY_SETTLED | REJECTED | RETURNED | RECALLED | REVERSED | UNKNOWN
  // §53 Payment Leg Certificate
  valueDate           DateTime?
  executionTimestamp  DateTime?
  returnCode          String?
  bankEvidenceRef     String?
  sgtxEventHash       String?
  reconciliationStatus String  @default("UNRECONCILED") // UNRECONCILED | MATCHED | DIVERGENT
  // Metadata
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([legState])
  @@index([settlementInstructionId])
}

// --- §63 Financial Exposure Engine ---
model FinancialExposure {
  id                  String   @id @default(cuid())
  ustn                String   @unique
  grossCommercialValue Float
  expectedSettlement   Float
  actualSettlement     Float    @default(0)
  returnedAmount       Float    @default(0)
  disputedAmount       Float    @default(0)
  fees                 Float    @default(0)
  adjustments          Float    @default(0)
  fxConsequences       Float    @default(0)
  penalties            Float    @default(0)
  compensation         Float    @default(0)
  recoverableAmount    Float    @default(0)
  outstandingExposure  Float    @default(0)
  reopenedExposure     Float    @default(0)
  contingentExposure   Float    @default(0)
  exposureState        String   @default("NONE") // NONE | OPEN | REOPENED | RESOLVED
  recoveryStatus       String?  // OPEN | IN_PROGRESS | RESOLVED
  currency            String   @default("USD")
  lastUpdated         DateTime @default(now()) @updatedAt
  createdAt           DateTime @default(now())

  @@index([ustn])
  @@index([exposureState])
}

// --- §66 Obligation Graph ---
model ObligationNode {
  id                  String   @id @default(cuid())
  ustn                String
  obligationId        String   @unique
  obligationType      String   // COMMERCIAL | DOCUMENT | LOGISTICS | CUSTOMS | COMPLIANCE | FINANCIAL
  beneficiary         String?
  amount              Float?
  currency            String?
  // Dependencies (§67)
  prerequisites       String?  // JSON array of obligation IDs
  dependencies        String?  // JSON array of obligation IDs
  // Conditions
  completionCondition String?  // JSON
  reversalCondition   String?
  disputeCondition    String?
  recoveryPath        String?
  financialConsequence Float?
  // State
  state               String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | FAILED | REVERSED | DISPUTED
  authority           String?
  evidenceRequirement  String?  // JSON
  deadline            DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([obligationType])
  @@index([state])
}

// --- §70 Exception Engine ---
model ExceptionEvent {
  id                  String   @id @default(cuid())
  exceptionId         String   @unique
  ustn                String?
  // Exception classification (§25)
  exceptionCategory   String   // FINANCIAL | DOCUMENT | MILESTONE | COMPLIANCE | RECONCILIATION | EXECUTION | CLOSURE
  exceptionType       String   // PAYMENT_PENDING | DOCUMENT_REVOKED | MILESTONE_DISPUTED | etc.
  // Severity (§72)
  severity            Int      @default(2) // 1=Info, 2=Operational, 3=Financial, 4=Suspension, 5=Legal
  // Inputs (§70)
  triggeringEvent     String?  // event ID
  currentStateVector  String?  // JSON snapshot
  policyApplied       String?
  // Output (§70)
  resolutionAction    String?  // CONTINUE | PAUSE | ESCALATE | RECONCILE | CORRECT | COMPENSATE | REQUEST_AUTHORITY | CLOSE_WITH_EXCEPTION
  // Containment (§71)
  affectedScope       String?  // JSON array of affected obligation IDs
  // SLA (§73)
  detectionDeadline   DateTime?
  acknowledgmentDeadline DateTime?
  resolutionTarget    DateTime?
  escalationDeadline  DateTime?
  // Status
  status              String   @default("OPEN") // OPEN | ACKNOWLEDGED | IN_PROGRESS | RESOLVED | ESCALATED | CLOSED
  acknowledgedBy      String?
  acknowledgedAt      DateTime?
  resolvedBy          String?
  resolvedAt          DateTime?
  resolutionNotes     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([exceptionType])
  @@index([severity])
  @@index([status])
}

// --- §91 Recovery Vault ---
model RecoveryVaultEntry {
  id                  String   @id @default(cuid())
  ustn                String?
  entryType           String   // EVENT_HISTORY | STATE_TRANSITION | EVIDENCE | AUTHORITY_DETERMINATION | POLICY_VERSION | RECONCILIATION_CASE | DISPUTE_PACKET | CORRECTIVE_ACTION | RECOVERY_ACTION | SETTLEMENT_CERTIFICATE | CLOSURE_CERTIFICATE
  entryReference      String?  // ID of the referenced object
  entryHash           String?  // SHA-256 of the entry content
  entryContent        String?  // JSON content for small entries
  entryUrl            String?  // URL for large entries
  // Metadata
  createdAt           DateTime @default(now())

  @@index([ustn])
  @@index([entryType])
}

// --- §57 External Identifier Registry ---
model ExternalIdentifier {
  id                  String   @id @default(cuid())
  ustn                String?
  identifierType      String   // BANK_REFERENCE | NAFEZA_ACID | NAFEZA_UCR | CARGOX_REF | CUSTOMS_REF | ERP_REF | MARKETPLACE_REF | INVOICE_NUMBER | BL_NUMBER | CONTRACT_ID | DOCUMENT_ID
  identifierValue     String
  issuingAuthority    String?
  issuerSystem        String?
  relatedEntity       String?
  relatedEventId      String?
  validity            String?  // ACTIVE | EXPIRED | REVOKED
  lifecycleStatus     String   @default("ACTIVE")
  source              String?
  evidence            String?  // JSON
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@unique([identifierType, identifierValue])
  @@index([ustn])
  @@index([identifierType])
  @@index([identifierValue])
}

// --- §37 Bank Settlement Gateway ---
model BankSettlementGateway {
  id                  String   @id @default(cuid())
  gatewayId           String   @unique
  ustn                String?
  bankGtid            String?
  bankName            String?
  // Integration type (§36)
  integrationType     String   // ISO_20022 | API | H2H | SFTP
  // Instruction
  instructionPayload  String?  // JSON
  instructionVersion  Int      @default(1)
  // Gateway processing (§62)
  schemaValidated     Boolean  @default(false)
  signatureValidated  Boolean  @default(false)
  ustnValidated       Boolean  @default(false)
  beneficiaryConsistency Boolean @default(false)
  bankPolicyChecked   Boolean  @default(false)
  amlSanctionsChecked Boolean  @default(false)
  // Status
  status              String   @default("DRAFT") // DRAFT | VALIDATED | SUBMITTED | BANK_ACCEPTED | PROCESSING | EXECUTED | REJECTED | RETURNED | UNKNOWN
  bankResponse        String?  // JSON
  // Metadata
  submittedAt         DateTime?
  bankConfirmedAt     DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([bankGtid])
  @@index([status])
}

// --- §90 Dispute Packet ---
model DisputePacket {
  id                  String   @id @default(cuid())
  packetId            String   @unique
  ustn                String?
  // Packet contents (§90)
  transactionHistory  String?  // JSON
  timeline            String?  // JSON
  contractReferences   String?  // JSON
  applicableClauses   String?  // JSON
  documents           String?  // JSON
  signatures          String?  // JSON
  bankPaymentEvents   String?  // JSON
  logisticsEvidence   String?  // JSON
  authorityEvents     String?  // JSON
  reconciliationDiscrepancies String? // JSON
  stateChanges        String?  // JSON
  eventReasons        String?  // JSON
  supportingEvidence  String?  // JSON
  aiGeneratedSummary  String?
  sourceReferences    String?  // JSON
  // Status
  status              String   @default("ASSEMBLED") // ASSEMBLED | REVIEWED | RESOLVED | ARCHIVED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([ustn])
  @@index([status])
}

// --- §11 Closure Policy Engine ---
model ClosurePolicy {
  id                  String   @id @default(cuid())
  policyId            String   @unique
  policyName          String
  // Required conditions (§121 — 32 constitutional rules subset)
  requireDeliveryAccepted Boolean @default(true)
  requireSettlementComplete Boolean @default(true)
  requireFinancialReconciliation Boolean @default(true)
  requireCustomsComplete Boolean @default(true)
  requirePostClearance Boolean @default(true)
  requireDisputesResolved Boolean @default(true)
  requireEvidenceSealed Boolean @default(true)
  // Additional configurable conditions
  customConditions    String?  // JSON array of { condition, description }
  // Post-closure (§22)
  postClosureObservationDays Int?
  // Version
  version             Int      @default(1)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([policyName])
  @@index([active])
}
