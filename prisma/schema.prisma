// SGTX Platform — Sovereign Governed Trade Execution
// Prisma schema (SQLite). Blueprint v11.1 — full data model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== Identity =====
model Tenant {
  id              String   @id @default(cuid())
  gtid            String   @unique // SGTX-{COUNTRY}-{TYPE}-{SEQ}-{CHECKSUM}
  legalName       String
  type            String   // TRD | LSP | SHIP | LAB | QC | CBR | BANK | PFI | GOV | ADM | MKT
  country         String   // ISO 3166-1 alpha2
  traderMode      String   @default("NONE") // BUY | SELL | DUAL | NONE
  kybTier         Int      @default(1)
  trustScore      Int      @default(70)
  trustConfidence Float?   // CERT-FIX: confidence in trust score (0-1)
  kybStatus       String?  // CERT-FIX: KYB verification status
  pepStatus       String?  // CERT-FIX: PEP status (PEP | NON_PEP | UNKNOWN)
  lifecycleState  String   @default("VERIFIED") // PENDING | VERIFIED | SUSPENDED | EXITED
  sanctionsCleared Boolean @default(true)
  defiAllowed     Boolean  @default(false)
  // Part 9 — Tenant may opt out of anonymous (RFQ-broadcast) financing requests.
  anonymousRfqOptOut Boolean @default(false)
  city            String?
  logoColor       String?
  sector          String?
  // Bank details (captured during registration)
  bankSwift       String?  // SWIFT/BIC code (e.g., NBECEGCX)
  bankName        String?  // Auto-detected from SWIFT
  bankBranch      String?
  bankCity        String?
  bankAccountName String?
  bankAccountNo   String?  // IBAN or local account number
  bankCurrency    String?  // ISO 4217 currency of the account
  bankIbanFormat  String?  // JSON snapshot of IBAN format for the country
  // Free-form JSON notes (e.g. open-registry verification snapshots, audit trail).
  globalNotes     String?
  createdAt       DateTime @default(now())

  tradesAsBuyer   Trade[]  @relation("BuyerTrades")
  tradesAsSeller  Trade[]  @relation("SellerTrades")
  activities      Activity[]
  inboxItems      InboxItem[]
  employees       Employee[]
  bidFinancing    FinancingBid[]
  financingRequests FinancingRequest[] @relation("BorrowerFinancing")
  labTests        LabTest[]
  qcInspections   QcInspection[]
  customsDecls    CustomsDeclaration[]
  quotations      ServiceQuotation[]
  shipmentsCarrier Shipment[] @relation("CarrierShipments")
}

model Employee {
  id            String   @id @default(cuid())
  tenantGtid    String
  tenant        Tenant   @relation(fields: [tenantGtid], references: [gtid], onDelete: Cascade)
  fullName      String
  email         String   @unique
  role          String   // OWNER | ADMIN | OPERATOR | DRIVER | INSPECTOR | ANALYST | OFFICER
  allowRoleSwitching Boolean @default(false)
  defaultTraderMode  String   @default("NONE") // BUY | SELL | DUAL | NONE
  activeTraderMode   String   @default("NONE") // BUY | SELL | DUAL | NONE
  avatarColor   String?
  // Auth fields (added CERT-FIX Batch 1)
  passwordHash        String?
  totpSecret          String?
  isActive            Boolean  @default(true)
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
  @@index([tenantGtid])
}

// ===== Trade & USTN =====
model Trade {
  id            String   @id @default(cuid())
  ustn          String   @unique // SGTX-{BUYER6}-{SELLER6}-{TS}-{RAND8}
  buyerGtid     String
  sellerGtid    String
  buyer         Tenant   @relation("BuyerTrades", fields: [buyerGtid], references: [gtid])
  seller        Tenant   @relation("SellerTrades", fields: [sellerGtid], references: [gtid])
  commodity     String
  commodityHs   String?
  incoterm      String   // EXW | FCA | FOB | CFR | CIF | DAP | DPU | DDP
  grossWeightKg Int
  netWeightKg   Int
  tradeValueUsd Float
  currency      String   @default("USD")
  originPort    String
  destPort      String
  originCountry String
  destCountry   String
  phase         Int      @default(0) // 0-8
  status        String   @default("INITIATED") // INITIATED | QUOTED | NEGOTIATING | CONTRACT_SIGNED | IN_EXECUTION | DELIVERED | SETTLED | DISPUTED | DISTRESSED
  healthScore   Int      @default(85)
  multiShipment Boolean  @default(false)
  sgtxFeeUsd    Float?
  coldChain     Boolean  @default(false)
  containerCount Int     @default(1)
  // Commercial terms (Phase 1 form)
  orderBy       String?  // weight | cartons | packaging | container
  orderValue    String?  // global value for weight/cartons/packaging
  paymentTerms  String?  // TT | CAD | LC
  paymentTermsDetails String? // free-text bank / LC details
  packaging     String?  // global default packaging type
  globalNotes   String?  // trade-wide notes (max 2000 chars)

  // Part 4.5 — Documentation Requirements (one source of truth, trigger-driven)
  // Documents themselves are persisted in DocumentRequirement rows (see below).

  // Part 4.6 — Special Trade Instructions
  specialInstructions String? // free-text + AI-extracted structured (JSON) categories

  // Part 4.7 — Transport & Logistics
  transportMode String?  // OCEAN | AIR | RAIL | TRUCK | MULTIMODAL
  equipmentType String?  // STANDARD | REEFER | HC | OPEN_TOP | FLAT_RACK | TANK | ULD_PALLET | DRY_VAN | BOX_WAGON | ...
  equipmentCount Int?
  alternativePorts String? // JSON array of UN/LOCODEs
  earliestDeliveryDate DateTime?
  preferredDeliveryDate DateTime?
  latestDeliveryDate DateTime?
  transitTimeDays Int?

  // Part 4.8 — Insurance Requirements
  insuranceRequirement String? // REQUIRED | OPTIONAL | NOT_REQUIRED
  insuranceType String?  // ALL_RISKS | FPA | WA | ICC_A | ICC_B | ICC_C | REEFER
  insuranceResponsibleParty String? // BUYER | SELLER | ACCORDING_TO_INCOTERM
  insuranceCoveragePct Int? // 100 | 110 | 120 | custom
  insuranceCurrency String? // mirrors trade currency by default

  // Part 4.9 — Commercial Settlement Requirements
  settlementStructure String? // DOCUMENTARY_CREDIT | DOCUMENTARY_COLLECTION | BANK_TRANSFER | OPEN_ACCOUNT | TO_BE_NEGOTIATED
  paymentTiming String?  // ADVANCE | PARTIAL_ADVANCE | AGAINST_DOCUMENTS | AGAINST_SHIPMENT | AGAINST_DELIVERY | DEFERRED | TO_BE_NEGOTIATED
  creditPeriod String?   // 0_DAYS | 15_DAYS | 30_DAYS | 45_DAYS | 60_DAYS | 90_DAYS | CUSTOM
  creditPeriodCustomDays Int?
  commercialPriority String? // LOWEST_COST | FASTEST_SETTLEMENT | FINANCING_FRIENDLY | BALANCED
  financingInterest String? // BUYER | SELLER | EITHER_PARTY | NONE
  bankInstrument String? // LC | BG | SBLC | DLC | NONE
  settlementFlexibility String? // FIXED | FLEXIBLE | OPEN_TO_ALTERNATIVES
  balanceTiming String?  // free-text — when partial-advance balance is paid
  settlementDocuments String? // JSON array of required settlement document types
  originalDocsRequired Boolean? // true | false | null
  documentLanguage String? // ISO language code
  blType        String?  // EB_L | ORIGINAL — Bill of Lading type (Phase 3.12)

  // Part 4.9a — Optional Buyer-Requested Services (with extra fees)
  // Buyer can opt into third-party QC inspection + additional lab tests at trade-request time.
  // Pesticides panel is FREE (baseline food-safety); microbiology + heavy metals are extra-cost.
  optionalQcInspection   Boolean  @default(false) // buyer requested third-party QC inspection
  qcInspectionType       String?  // PRE_SHIPMENT | LOADING | DISCHARGE — which QC stage
  qcInspectionFeeUsd     Float?   // extra fee for optional QC (estimated, confirmed on quote accept)
  labTestsRequested      String?  // JSON array of {testType, feeUsd, isExtraCost} — buyer-selected lab tests
  labTestsFeeUsd         Float?   // sum of extra-cost lab test fees
  optionalServicesTotalUsd Float? // sum of all optional services (QC + extra lab tests)

  // Part 4.10 — Trade Request Readiness (advisory, 0-100)
  readinessScore Int?
  readinessMissing String? // JSON array of {field, severity, message}

  // Part 4.11 — Trade Criticality
  tradeCriticality String? // ROUTINE | PRIORITY | CRITICAL
  criticalitySuggested String?
  criticalityConfidence Float?
  criticalityAdjustmentReason String?

  // Part 3.6 — Multi-shipment master contract linkage
  masterContractId String? // MC-{buyer6}-{seller6}-{ts}; shared across all shipments in a master contract
  // Part 3.7 — Distressed micro-contract linkage to parent USTN
  parentUstn    String?  // for micro-contracts (distressed cargo) — points to the originating parent trade USTN
  isSandbox     Boolean  @default(false) // CERT-FIX: sandbox trades can be safely reset without affecting real trades
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Part 4.5 — Document requirements (one source of truth)
  documentRequirements DocumentRequirement[]

  containers    TradeContainer[]
  shipments     Shipment[]
  documents     Document[]
  activities    Activity[]
  invoices      Invoice[]
  disputes      Dispute[]
  financing     FinancingRequest[]
  inboxItems    InboxItem[]
  labTests      LabTest[]
  qcInspections QcInspection[]
  customsDecls  CustomsDeclaration[]
  quotations    ServiceQuotation[]
  timeline      TimelineEvent[]
  chatMessages  TradeMessage[]
  contracts     TradeContract[]
  buyerSubmissions BuyerSubmission[]

  // Mode B/C logistics provider GTID assignment — JSON of
  // { serviceName: { gtids: string[], mode: "B"|"C", status: "PENDING_RFQ"|"RESPONDED"|"LOCKED", rfqAll: boolean, rfqId? } }
  logisticsModeGtids String?
  // Mode B/C RFQ summary — JSON of
  // { pendingCount, respondedCount, lockedCount, fullQuotePending: boolean }
  logisticsRfqSummary String?

  // Part 3.13 — Post-Contract Customs Broker Assignment
  // After the contract is locked (CONTRACT_SIGNED), both buyer and seller
  // must designate a licensed customs broker for their respective side of
  // clearance (seller = export, buyer = import). They may designate their
  // freight forwarder if that forwarder also holds a customs broker licence,
  // OR a dedicated customs broker (CBR tenant). The designated broker
  // receives the USTN + a Smart Inbox notification and is responsible for
  // uploading clearance documents later. This is the primary mechanism
  // while documentation is not yet fully digitalised.
  buyerCustomsBrokerGtid  String?  // CBR (or LSP-with-CBR) tenant handling IMPORT clearance
  sellerCustomsBrokerGtid String?  // CBR (or LSP-with-CBR) tenant handling EXPORT clearance
  buyerCustomsBrokerAssignedAt  DateTime?
  sellerCustomsBrokerAssignedAt DateTime?

  // CERT-FIX: Critical indexes for query performance
  @@index([buyerGtid])
  @@index([sellerGtid])
  @@index([status])
  @@index([parentUstn])
  @@index([masterContractId])
  @@index([isSandbox])
  @@index([createdAt])
}

// ===== Buyer Submission (Phase 2.5 — Post-Quote Buyer Detail Capture) =====
// After receiving the seller's quote, the buyer submits consignee + notify
// parties + per-document dispatch addresses. Buyer info auto-fills from GTID
// (Tenant record). Consignee has a "same as buyer" checkbox.
model BuyerSubmission {
  id            String   @id @default(cuid())
  submissionId  String   @unique // BS-YYYYMMDD-NNN
  tradeId       String
  trade         Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  ustn          String
  buyerGtid     String
  // Auto-filled from Tenant (snapshot at submission time)
  buyerLegalName  String
  buyerCountry    String
  buyerCity       String?
  buyerAddress    String?
  buyerTaxId      String?
  // Consignee — if consigneeSameAsBuyer, copies buyer info
  consigneeSameAsBuyer Boolean @default(false)
  consigneeJson     String?  // JSON: { name, address, country, city, postalCode, phone, email, taxId }
  // Notify parties (1 or more)
  notifyPartiesJson String?  // JSON array of { name, address, country, city, postalCode, phone, email }
  // Document dispatch addresses — 1 or more addresses; each gets different
  // document types sent to it. Used by document/courier workflow.
  documentDispatchAddressesJson String? // JSON array of { label, address, country, city, postalCode, attention, phone, documentTypes: string[], courier: DHL|UPS|FEDEX|OTHER }
  status        String   @default("SUBMITTED") // SUBMITTED | ACKNOWLEDGED | AMENDED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tradeId])
  @@index([ustn])
  @@index([buyerGtid])
}

// ===== Phase 3 — State-of-the-Art International Trade Contracts =====
// Court-ready contract system compliant with CISG, Incoterms 2020, UCP 600,
// ISM Code, local laws (EG/DE/UAE/EN), and international arbitration rules
// (ICC, LCIA, CRCICA, DIFC, UNCITRAL). Full HTML + JSON render, SHA-256 hash,
// versioned (v1, v2 amendments), QES signable, USTN-tracked, non-custodial.
model TradeContract {
  id                String   @id @default(cuid())
  contractId        String   @unique // SC-YYYYMMDD-NNN
  tradeId           String
  trade             Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  ustn              String
  contractVersion   Int      @default(1)
  contractType      String   // CIF_CONTRACT | FOB_CONTRACT | DAP_CONTRACT | DDP_CONTRACT | RORO_CONTRACT
  governingLaw      String   @default("EGYPTIAN_LAW") // EGYPTIAN_LAW | ENGLISH_LAW | GERMAN_LAW | UAE_LAW | UNIDROIT | CISG
  arbitrationClause String   // ICC | LCIA | CRCICA | DIFC | UNCITRAL
  arbitrationSeat   String   // Cairo | London | Paris | Dubai | Singapore
  language          String   @default("en") // en | ar | de | fr | dual
  contractJson      String?  // full contract as JSON
  contractHtml      String?  // full contract as HTML (printable)
  hashSha256        String?
  signedBy          String?  // JSON array of signer GTIDs
  signedAt          DateTime?
  status            String   @default("DRAFT") // DRAFT | GENERATED | SENT | SIGNED | EXECUTED | AMENDED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tradeId])
  @@index([ustn])
  @@index([status])
}

model Shipment {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  ustn          String
  sequence      Int      @default(1) // multi-shipment index
  vesselName    String?
  vesselImo     String?
  containerNo   String?
  containerCount Int     @default(1)
  carrierGtid   String?  // shipping line
  carrier       Tenant?  @relation("CarrierShipments", fields: [carrierGtid], references: [gtid])
  status        String   @default("PLANNED") // PLANNED | LOADED | DEPARTED | IN_TRANSIT | ARRIVED | RELEASED | DELIVERED
  originPort    String
  destPort      String
  etd           DateTime?
  eta           DateTime?
  departedAt    DateTime?
  arrivedAt     DateTime?
  releasedAt    DateTime?
  coldChainTemp Float?
  lat           Float?
  lng           Float?
  // LSP logistics assignment (Phase 5 - CONTAINER_LOADED milestone prep)
  driverName           String?
  truckNumber          String?
  loadingDate          DateTime?
  warehouseArrivalTime DateTime?
  warehouseDepartureTime DateTime?
  portCheckInTime      DateTime?
  createdAt     DateTime @default(now())
}

// ===== Trade Containers (per-container cargo manifest from Phase 1 form) =====
model TradeContainer {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  sequence      Int      @default(1) // 1-based index
  originCountry String
  destCountry   String
  port          String   // port of discharge
  palletized    Boolean  @default(true)
  palletSize    String?  // EUR | ISO | Custom
  destOverride  String?  // destination override (free zone, warehouse)
  notes         String?  // per-container notes
  containerSize String?  // 40ft | 20ft (set in Commercial Terms when orderBy=container)
  commodities   String   // JSON array of {product, hs, packaging, pallets, netWeight, grossWeight, notes}
  createdAt     DateTime @default(now())
}

// ===== Trade Request Drafts (Phase 1 autosave, 14-day expiry) =====
model TradeDraft {
  id            String   @id @default(cuid())
  draftId       String   @unique // client-side stable ID for upsert
  buyerGtid     String
  sellerGtid    String?
  incoterm      String?
  parsedSpecs   String?  // JSON {containers, commodityType, productName, hsCode, packaging, coldChain, orderBy, orderValue, paymentTerms, paymentTermsDetails}
  multiShipmentSchedule String? // JSON array of shipments
  globalNotes   String?
  status        String   @default("DRAFT") // DRAFT | SUBMITTED | EXPIRED
  expiresAt     DateTime? // set to now + 14 days at app layer
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ===== Documents =====
model Document {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  type          String   // COMMERCIAL_INVOICE | PACKING_LIST | CERTIFICATE_ORIGIN | PHYTO | HEALTH_CERT | BILL_LADING | CUSTOMS_DECL | LAB_REPORT | QC_REPORT | CONTRACT | LOGISTICS_ADDENDUM
  title         String
  status        String   @default("REQUIRED") // REQUIRED | UPLOADED | VERIFIED | MISSING | REJECTED
  uploadedBy    String?
  fileSizeKb    Int?
  hashSha256    String?
  verifiedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ===== Part 4.5 — Documentation Requirements (single source of truth, trigger-driven) =====
model DocumentRequirement {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  docType       String   // COMMERCIAL_INVOICE | PACKING_LIST | BILL_LADING | COO | PHYTO | HEALTH_CERT | FUMIGATION | INSURANCE_CERT | INSPECTION_CERT | LAB_REPORT | EXPORT_LICENSE | IMPORT_LICENSE | COLD_TREATMENT | COLD_CHAIN_LOG | EUR1 | GOTS | HALAL | LC_APPLICATION | LC_CONFIRMATION | FINANCING_AGREEMENT | COLLATERAL
  docName       String   // human-readable label
  trigger       String   // SHIPMENT | SETTLEMENT | CUSTOMS | FINANCING  (single primary trigger; multiple stored as CSV)
  mandatory     Boolean  @default(false)
  issuingAuthority String? // SELLER | BUYER | BROKER | SHIPPING_LINE | CUSTOMS | CHAMBER_OF_COMMERCE | THIRD_PARTY
  format        String?  // ELECTRONIC | ORIGINAL | ELECTRONIC_ORIGINAL
  notes         String?  // additional notes (e.g., language, legalisation)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tradeId])
  @@index([docType])
  @@unique([tradeId, docType])
}

// ===== Activity / Audit =====
model Activity {
  id            String   @id @default(cuid())
  tradeId       String?
  trade         Trade?   @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  actorGtid     String?
  actor         Tenant?  @relation(fields: [actorGtid], references: [gtid])
  action        String   // APPROVED_INVOICE | SUBMITTED_DECLARATION | SIGNED_CONTRACT | UPLOADED_DOC | PAID_FEE | CONFIRMED_MILESTONE | FILED_DISPUTE ...
  description   String
  type          String   @default("INFO") // SUCCESS | INFO | WARNING | CRITICAL
  metadata      String?
  createdAt     DateTime @default(now())
  // CERT-FIX: Critical indexes
  @@index([tradeId, createdAt])
  @@index([actorGtid, createdAt])
  @@index([action])
}

model TimelineEvent {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  phase         Int
  label         String
  description   String
  actorGtid     String?
  completed     Boolean  @default(false)
  completedAt   DateTime?
  createdAt     DateTime @default(now())
}

model TradeMessage {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  senderGtid    String
  senderName    String
  message       String
  isAi          Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// ===== Invoices & Payments =====
model Invoice {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  type          String   // COMMERCIAL | LOGISTICS | SGTX_FEE | BROKER | LAB | QC | FINANCING
  number        String
  invoiceNumber String?  // CERT-FIX: external invoice number
  amountUsd     Float
  currency      String   @default("USD")
  status        String   @default("PENDING") // PENDING | APPROVED | PAID | OVERDUE | DISPUTED
  payerGtid     String
  payeeGtid     String
  ublXml        String?  // CERT-FIX: UBL 2.1 XML representation
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  @@index([tradeId])
  @@index([payerGtid, status])
}

// ===== Smart Inbox =====
model InboxItem {
  id            String   @id @default(cuid())
  tenantGtid    String
  tenant        Tenant   @relation(fields: [tenantGtid], references: [gtid], onDelete: Cascade)
  tradeId       String?
  trade         Trade?   @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  category      String   // NEEDS_SIGNATURE | NEEDS_APPROVAL | NEEDS_DOCUMENT | NEEDS_PAYMENT | SHIPMENT_ALERT | NEW_OFFER | NEGOTIATION | COMPLIANCE | GENERAL
  priority      Int      @default(50) // 0-100
  title         String
  description   String
  ctaLabel      String?
  deadline      DateTime?
  dismissed     Boolean  @default(false)
  snoozedUntil  DateTime?
  createdAt     DateTime @default(now())
  // CERT-FIX: Critical indexes
  @@index([tenantGtid, dismissed, priority])
  @@index([tenantGtid, createdAt])
  @@index([tradeId])
  @@index([category])
}

// ===== Disputes =====
model Dispute {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  ustn          String?  // denormalised USTN of the disputed trade (Phase 8 audit — USTN traceability)
  type          String   // QUALITY | DELAY | NON_PAYMENT | DOC_FRAUD | COLD_CHAIN | SERVICE_QUALITY | FINANCING | SGTX_FEE
  status        String   @default("FILED") // FILED | MEDIATION | ARBITRATION | RESOLVED | ESCALATED
  filedByGtid   String
  respondentGtid String? // counterparty GTID (derived from trade if not provided at filing)
  claimAmountUsd Float
  description   String
  evidenceCount Int      @default(0)
  aiRootCause   String?
  resolution    String?
  resolutionNotes String? // CERT-FIX: resolution notes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Back-relations — Phase 8 audit gap-fix. Without these, consumers could
  // not `include: { mediation: true, evidence: true, ... }` from Dispute and
  // were forced into N+1 patterns. Each child already has `disputeId` FK.
  mediation          DisputeMediation[]
  evidence           DisputeEvidence?
  experts            DisputeExpert[]
  proposals          SettlementProposal[]
  arbitrationCases   ArbitrationCase[]
  prediction         DisputePrediction?
  qcOverrideFlags    QcOverrideFlag[]
  causalAttributions CausalAttribution[]

  // CERT-FIX: Critical indexes
  @@index([tradeId])
  @@index([status])
  @@index([filedByGtid])
  @@index([createdAt])
}

// ===== Financing (Phase 4 — Universal Trade Finance) =====
model FinancingRequest {
  id              String   @id @default(cuid())
  requestId       String   @unique // FR-YYYYMMDD-NNN
  tradeId         String
  trade           Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  borrowerGtid    String
  borrower        Tenant   @relation("BorrowerFinancing", fields: [borrowerGtid], references: [gtid])
  shipmentSeq     Int?     // for multishipment: specific shipment index
  ustn            String?  // shipment USTN (multishipment) or trade USTN
  amountUsd       Float    // requested amount P
  totalTradeValue Float    // copy of trade value at request time
  financingType   String   // PRE_SHIPMENT | POST_SHIPMENT | INVOICE_FINANCING | STRUCTURED
  tenorDays       Int
  preferredSettlement String // BANK_TRANSFER | STABLECOIN | DEFI_PROTOCOL
  preferredCurrency String @default("USD")
  collateralType  String   // GOODS | WAREHOUSE_RECEIPT | RECEIVABLES | NONE
  specialInstructions String?
  recommendedLtv  Float?   // AI advisory %
  status          String   @default("REQUESTED") // REQUESTED | RFQ_BROADCAST | BIDDING_OPEN | BIDDING_CLOSED | AGREEMENT_PENDING | SIGNING | DISBURSING | ACTIVE | REPAID | REJECTED | WITHDRAWN
  creditScore     Int?     // 0-100
  defaultProbability Float? // 0-100%
  creditIntelligence String? // JSON: signals, narratives
  biddingWindowEndsAt DateTime?
  blendedApr      Float?   // weighted avg of accepted bids
  feeUsd          Float?   // 0.25% of financed amount
  feeLockStatus   String   @default("PENDING") // PENDING | ACTIVE | RELEASED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bids            FinancingBid[]
  rfqLogs         FinancingRfqLog[]
  agreements      FinancingAgreement[]
  repayments      FinancingRepayment[]
}

model FinancingBid {
  id              String   @id @default(cuid())
  bidId           String   @unique // BID-YYYYMMDD-NNN
  requestId       String
  request         FinancingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  financierGtid   String
  financier       Tenant   @relation(fields: [financierGtid], references: [gtid])
  amountOffered   Float    // portion of P
  apr             Float    // All-in cost %
  settlementMethod String  // BANK_TRANSFER | STABLECOIN | DEFI_PROTOCOL
  collateralRequired String // must match or be stricter than borrower's
  conditions      String?
  noteToBorrower  String?
  isDeFi          Boolean  @default(false)
  deFiProtocol    String?  // AAVE_V3 | COMPOUND | MAKERDAO | ...
  deFiRiskAcknowledgedAt DateTime?
  matchScore      Int      @default(0) // 0-100
  encryptedPayload String?  // base64 — client-side encrypted with borrower pubkey
  status          String   @default("SUBMITTED") // SUBMITTED | ACCEPTED | REJECTED | WITHDRAWN
  createdAt       DateTime @default(now())
  annex           FinancingAgreementAnnex?
}

model FinancierPreference {
  id              String   @id @default(cuid())
  financierGtid   String   @unique
  acceptedBorrowerCountries String // JSON array of ISO codes
  minTrustScore   Int      @default(70)
  minTradeValue   Float    @default(10000)
  maxFinancedPerRequest Float @default(500000)
  preferredFinancingTypes String // JSON: ["PRE_SHIPMENT", ...]
  preferredSettlementMethods String // JSON
  excludedCommodities String  // JSON: HS chapter codes ["0811", ...]
  geographicMode  String   @default("ALL") // ALL | ACCEPT_ONLY | ALL_EXCEPT
  geographicList  String?  // JSON: country list for ACCEPT_ONLY/ALL_EXCEPT
  minTrancheSize  Float    @default(10000)
  defaultAprBenchmark Float @default(5.0)
  enableDeFi      Boolean  @default(false)
  notificationsEnabled Boolean @default(true)
  webhookUrl      String?
  updatedAt       DateTime @default(now())
}

model FinancingRfqLog {
  id              String   @id @default(cuid())
  requestId       String
  request         FinancingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  financierGtid   String
  matchScore      Int
  deliveredVia    String   // INBOX | EMAIL | WEBHOOK
  status          String   @default("DELIVERED") // DELIVERED | VIEWED | OPTED_OUT
  createdAt       DateTime @default(now())
}

model FinancingAgreement {
  id              String   @id @default(cuid())
  agreementId     String   @unique // FA-YYYYMMDD-NNN
  requestId       String
  request         FinancingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  masterContractHash String // SHA-256 of master agreement text
  witnessClauseText String  // mandatory SGTX Financing Witness Clause
  borrowerSignedAt DateTime?
  financierSignedAt DateTime?
  governorSignedAt DateTime?
  governorSignature String?  // Ed25519
  status          String   @default("PENDING_SIGNATURES") // PENDING_SIGNATURES | FULLY_SIGNED | DISBURSED | ACTIVE | COMPLETED | DEFAULTED
  totalAcceptedAmount Float
  blendedApr      Float
  createdAt       DateTime @default(now())
  annexes         FinancingAgreementAnnex[]
}

model FinancingAgreementAnnex {
  id              String   @id @default(cuid())
  agreementId     String
  agreement       FinancingAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  bidId           String   @unique
  bid             FinancingBid @relation(fields: [bidId], references: [id], onDelete: Cascade)
  financierGtid   String
  amountFinanced  Float
  apr             Float
  tenorDays       Int
  repaymentSchedule String  // JSON: [{dueDate, principal, interest, total}]
  collateralTerms String
  feeUsd          Float    // 0.25% of amountFinanced
  borrowerNetProceeds Float // amountFinanced - fee
  financierSignedAt DateTime?
  disbursedAt     DateTime?
  pspSplitReference String?
  status          String   @default("PENDING") // PENDING | SIGNED | DISBURSED | REPAYING | REPAID | DEFAULTED
  createdAt       DateTime @default(now())
  defiPosition    DeFiPosition?
}

model FinancingRepayment {
  id              String   @id @default(cuid())
  requestId       String
  request         FinancingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  annexId         String?
  financierGtid   String
  amountUsd       Float
  method          String   // BANK_TRANSFER | STABLECOIN | DEFI_ONCHAIN
  txReference     String?
  detectedVia     String   // PSP_WEBHOOK | OPEN_BANKING | ONCHAIN_GRAPH
  status          String   @default("DETECTED") // DETECTED | CONFIRMED | REVERSED
  repaidAt        DateTime @default(now())
}

model DeFiProtocol {
  id              String   @id @default(cuid())
  name            String   @unique // AAVE_V3 | COMPOUND | MAKERDAO
  displayName     String
  chain           String   @default("Ethereum")
  riskScore       Int      @default(85) // 0-100
  tvlUsd          Float    @default(0)
  auditStatus     String   @default("AUDITED") // AUDITED | UNAUDITED | EXPIRED
  lastExploit     String?
  governanceActivity String  @default("ACTIVE") // ACTIVE | LOW | STALE
  healthColor     String   @default("GREEN") // GREEN | YELLOW | ORANGE | RED
  contractAddress String?
  updatedAt       DateTime @default(now())
}

model DeFiPosition {
  id              String   @id @default(cuid())
  annexId         String   @unique  // one position per annex
  annex           FinancingAgreementAnnex @relation(fields: [annexId], references: [id], onDelete: Cascade)
  protocolName    String
  borrowerGtid    String
  financierGtid   String
  principalUsd    Float
  healthFactor    Float    @default(2.0)
  predictedHealth24h Float?
  collateralUsd   Float
  debtUsd         Float
  liquidationThreshold Float @default(0.8)
  status          String   @default("ACTIVE") // ACTIVE | WARNING | LIQUIDATION_RISK | LIQUIDATED | REPAID
  lastCheckedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
}

model StablecoinStatus {
  id              String   @id @default(cuid())
  symbol          String   @unique // USDC | USDT | DAI
  pegUsd          Float    @default(1.0)
  deviationPct    Float    @default(0.0)
  oracle          String   @default("CoinGecko")
