generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // CCL-004: Static file: URL for Prisma's sqlite provider. The actual DB
  // connection is handled by the @prisma/adapter-libsql driver adapter in
  // src/lib/db.ts (connects to Turso). This static URL is only used by
  // Prisma's constructor validation + `prisma generate` — never for queries.
  // We use a static URL instead of env("DATABASE_URL") because the env var
  // may be a libsql:// URL (Turso) which the sqlite provider rejects.
  url = "file:/tmp/sgtx-prisma-dummy.db"
}

model Tenant {
  id                 String               @id @default(cuid())
  gtid               String               @unique
  legalName          String
  type               String
  country            String
  traderMode         String               @default("NONE")
  kybTier            Int                  @default(1)
  trustScore         Int                  @default(70)
  trustConfidence    Float?
  kybStatus          String?
  pepStatus          String?
  lifecycleState     String               @default("VERIFIED")
  sanctionsCleared   Boolean              @default(true)
  defiAllowed        Boolean              @default(false)
  anonymousRfqOptOut Boolean              @default(false)
  city               String?
  logoColor          String?
  sector             String?
  bankSwift          String?
  bankName           String?
  bankBranch         String?
  bankCity           String?
  bankAccountName    String?
  bankAccountNo      String?
  bankCurrency       String?
  bankIbanFormat     String?
  globalNotes        String?
  createdAt          DateTime             @default(now())
  activities         Activity[]
  customsDecls       CustomsDeclaration[]
  employees          Employee[]
  bidFinancing       FinancingBid[]
  financingRequests  FinancingRequest[]   @relation("BorrowerFinancing")
  inboxItems         InboxItem[]
  labTests           LabTest[]
  qcInspections      QcInspection[]
  quotations         ServiceQuotation[]
  shipmentsCarrier   Shipment[]           @relation("CarrierShipments")
  tradesAsSeller     Trade[]              @relation("SellerTrades")
  tradesAsBuyer      Trade[]              @relation("BuyerTrades")
}

model Employee {
  id                  String    @id @default(cuid())
  tenantGtid          String
  fullName            String
  email               String    @unique
  role                String
  allowRoleSwitching  Boolean   @default(false)
  defaultTraderMode   String    @default("NONE")
  activeTraderMode    String    @default("NONE")
  avatarColor         String?
  passwordHash        String?
  totpSecret          String?
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt
  tenant              Tenant    @relation(fields: [tenantGtid], references: [gtid], onDelete: Cascade)

  @@index([tenantGtid])
}

model Trade {
  id                            String                @id @default(cuid())
  ustn                          String                @unique
  buyerGtid                     String
  sellerGtid                    String
  commodity                     String
  commodityHs                   String?
  incoterm                      String
  grossWeightKg                 Int
  netWeightKg                   Int
  tradeValueUsd                 Float
  currency                      String                @default("USD")
  originPort                    String
  destPort                      String
  originCountry                 String
  destCountry                   String
  phase                         Int                   @default(0)
  status                        String                @default("INITIATED")
  healthScore                   Int                   @default(85)
  multiShipment                 Boolean               @default(false)
  sgtxFeeUsd                    Float?
  coldChain                     Boolean               @default(false)
  containerCount                Int                   @default(1)
  orderBy                       String?
  orderValue                    String?
  paymentTerms                  String?
  paymentTermsDetails           String?
  packaging                     String?
  globalNotes                   String?
  specialInstructions           String?
  transportMode                 String?
  equipmentType                 String?
  equipmentCount                Int?
  alternativePorts              String?
  earliestDeliveryDate          DateTime?
  preferredDeliveryDate         DateTime?
  latestDeliveryDate            DateTime?
  transitTimeDays               Int?
  insuranceRequirement          String?
  insuranceType                 String?
  insuranceResponsibleParty     String?
  insuranceCoveragePct          Int?
  insuranceCurrency             String?
  settlementStructure           String?
  paymentTiming                 String?
  creditPeriod                  String?
  creditPeriodCustomDays        Int?
  commercialPriority            String?
  // CCL-004: Full multi-axis buyer priority profile (JSON of BuyerPriorityProfile)
  buyerPriorityProfile           String?
  financingInterest             String?
  bankInstrument                String?
  settlementFlexibility         String?
  balanceTiming                 String?
  settlementDocuments           String?
  originalDocsRequired          Boolean?
  documentLanguage              String?
  blType                        String?
  optionalQcInspection          Boolean               @default(false)
  qcInspectionType              String?
  qcInspectionFeeUsd            Float?
  labTestsRequested             String?
  labTestsFeeUsd                Float?
  optionalServicesTotalUsd      Float?
  readinessScore                Int?
  readinessMissing              String?
  tradeCriticality              String?
  criticalitySuggested          String?
  criticalityConfidence         Float?
  criticalityAdjustmentReason   String?
  masterContractId              String?
  parentUstn                    String?
  isSandbox                     Boolean               @default(false)
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  logisticsModeGtids            String?
  logisticsRfqSummary           String?
  buyerCustomsBrokerGtid        String?
  sellerCustomsBrokerGtid       String?
  buyerCustomsBrokerAssignedAt  DateTime?
  sellerCustomsBrokerAssignedAt DateTime?
  activities                    Activity[]
  buyerSubmissions              BuyerSubmission[]
  customsDecls                  CustomsDeclaration[]
  disputes                      Dispute[]
  documents                     Document[]
  documentRequirements          DocumentRequirement[]
  financing                     FinancingRequest[]
  inboxItems                    InboxItem[]
  invoices                      Invoice[]
  labTests                      LabTest[]
  qcInspections                 QcInspection[]
  quotations                    ServiceQuotation[]
  shipments                     Shipment[]
  timeline                      TimelineEvent[]
  seller                        Tenant                @relation("SellerTrades", fields: [sellerGtid], references: [gtid])
  buyer                         Tenant                @relation("BuyerTrades", fields: [buyerGtid], references: [gtid])
  containers                    TradeContainer[]
  contracts                     TradeContract[]
  chatMessages                  TradeMessage[]

  @@index([buyerGtid])
  @@index([sellerGtid])
  @@index([status])
  @@index([parentUstn])
  @@index([masterContractId])
  @@index([isSandbox])
  @@index([createdAt])
}

model BuyerSubmission {
  id                            String   @id @default(cuid())
  submissionId                  String   @unique
  tradeId                       String
  ustn                          String
  buyerGtid                     String
  buyerLegalName                String
  buyerCountry                  String
  buyerCity                     String?
  buyerAddress                  String?
  buyerTaxId                    String?
  consigneeSameAsBuyer          Boolean  @default(false)
  consigneeJson                 String?
  notifyPartiesJson             String?
  documentDispatchAddressesJson String?
  status                        String   @default("SUBMITTED")
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  trade                         Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
  @@index([ustn])
  @@index([buyerGtid])
}

model TradeContract {
  id                String    @id @default(cuid())
  contractId        String    @unique
  tradeId           String
  ustn              String
  contractVersion   Int       @default(1)
  contractType      String
  governingLaw      String    @default("EGYPTIAN_LAW")
  arbitrationClause String
  arbitrationSeat   String
  language          String    @default("en")
  contractJson      String?
  contractHtml      String?
  hashSha256        String?
  signedBy          String?
  signedAt          DateTime?
  status            String    @default("DRAFT")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  trade             Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
  @@index([ustn])
  @@index([status])
}

model Shipment {
  id                     String    @id @default(cuid())
  tradeId                String
  ustn                   String
  sequence               Int       @default(1)
  vesselName             String?
  vesselImo              String?
  containerNo            String?
  containerCount         Int       @default(1)
  carrierGtid            String?
  status                 String    @default("PLANNED")
  originPort             String
  destPort               String
  etd                    DateTime?
  eta                    DateTime?
  departedAt             DateTime?
  arrivedAt              DateTime?
  releasedAt             DateTime?
  coldChainTemp          Float?
  lat                    Float?
  lng                    Float?
  driverName             String?
  truckNumber            String?
  loadingDate            DateTime?
  warehouseArrivalTime   DateTime?
  warehouseDepartureTime DateTime?
  portCheckInTime        DateTime?
  createdAt              DateTime  @default(now())
  carrier                Tenant?   @relation("CarrierShipments", fields: [carrierGtid], references: [gtid])
  trade                  Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  // === Tier 3: Multimodal Transport ===
  transportMode          String    @default("SEA") // SEA | AIR | ROAD | RAIL | MULTIMODAL | INLAND_WATER
  // Air freight fields
  awbNumber              String?   // Master AWB (MAWB) or House AWB (HAWB)
  flightNumber           String?
  airportOfDeparture     String?   // IATA code
  airportOfDestination   String?   // IATA code
  // Road freight fields
  cmrNumber              String?   // CMR consignment note number
  truckLicensePlate      String?
  trailerLicensePlate    String?
  // Rail freight fields
  railConsignmentNote    String?   // CIM/SMGS consignment note
  trainNumber            String?
  wagonNumber            String?
  // Multimodal leg support
  parentShipmentId       String?   // for multi-leg: previous shipment in chain
  legSequence            Int       @default(1) // 1 = first leg, 2 = second leg, etc.
  // Reefer telemetry (Tier 3: time-series)
  reeferTelemetry        ReeferTelemetry[]
  // Lots assigned to this shipment
  lots                   Lot[]
}

model TradeContainer {
  id            String   @id @default(cuid())
  tradeId       String
  sequence      Int      @default(1)
  originCountry String
  destCountry   String
  port          String
  palletized    Boolean  @default(true)
  palletSize    String?
  destOverride  String?
  notes         String?
  containerSize String?
  commodities   String
  createdAt     DateTime @default(now())
  trade         Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  // === Tier 1: VGM (SOLAS Verified Gross Mass) — legal since 1 July 2016 ===
  vgmKg         Float?    // Verified Gross Mass in kg (container + cargo + dunnage)
  vgmMethod     String?  // "METHOD_1" (weighed) | "METHOD_2" (calculated)
  vgmVerifiedAt DateTime?
  vgmVerifiedBy String?  // GTID of the authorized weigher
  vgmSubmissionRef String? // carrier VGM submission reference
  vgmExempt     Boolean  @default(false) // exempt cargo (e.g. shippers' load & count)

  // === Tier 1: Container Seals — anti-pilferage chain of custody ===
  sealNumber1   String?  // primary seal (carrier)
  sealNumber2   String?  // secondary seal (customs / high-security)
  sealVerifiedAt DateTime?
  sealVerifiedBy String?
  sealBrokenAt  DateTime? // if seal was broken in transit (requires evidence)
  sealBreakReason String?

  // === Tier 1: Dangerous Goods (IMDG Code) ===
  isDangerous   Boolean  @default(false)
  imdgClass     String?  // e.g. "3", "8", "4.1"
  unNumber      String?  // e.g. "1760", "1203"
  properShippingName String? // technical name per IMDG Code
  packingGroup  String?  // "I" | "II" | "III"
  flashpointC   Float?   // flash point in °C
  marinePollutant Boolean @default(false)
  dgDeclarationDocId String? // reference to DG declaration Document
  segregationCode String? // IMDG segregation group
  emergencyContact String? // 24h emergency contact number
  limitedQuantities Boolean @default(false) // LQ exemption

  // === Lot tracking (Tier: Lot Number System) ===
  lots          Lot[]    // one container can hold multiple lots

  @@index([tradeId])
  @@index([containerSize])
  @@index([isDangerous])
}

model TradeDraft {
  id                    String    @id @default(cuid())
  draftId               String    @unique
  buyerGtid             String
  sellerGtid            String?
  incoterm              String?
  parsedSpecs           String?
  multiShipmentSchedule String?
  globalNotes           String?
  status                String    @default("DRAFT")
  expiresAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Document {
  id         String    @id @default(cuid())
  tradeId    String
  type       String
  title      String
  status     String    @default("REQUIRED")
  uploadedBy String?
  fileSizeKb Int?
  hashSha256 String?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  trade      Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model DocumentRequirement {
  id               String   @id @default(cuid())
  tradeId          String
  docType          String
  docName          String
  trigger          String
  mandatory        Boolean  @default(false)
  issuingAuthority String?
  format           String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  trade            Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@unique([tradeId, docType])
  @@index([tradeId])
  @@index([docType])
}

model Activity {
  id          String   @id @default(cuid())
  tradeId     String?
  actorGtid   String?
  action      String
  description String
  type        String   @default("INFO")
  metadata    String?
  createdAt   DateTime @default(now())
  actor       Tenant?  @relation(fields: [actorGtid], references: [gtid])
  trade       Trade?   @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId, createdAt])
  @@index([actorGtid, createdAt])
  @@index([action])
}

model TimelineEvent {
  id          String    @id @default(cuid())
  tradeId     String
  phase       Int
  label       String
  description String
  actorGtid   String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  trade       Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model TradeMessage {
  id         String   @id @default(cuid())
  tradeId    String
  senderGtid String
  senderName String
  message    String
  isAi       Boolean  @default(false)
  createdAt  DateTime @default(now())
  trade      Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String    @id @default(cuid())
  tradeId       String
  type          String
  number        String
  invoiceNumber String?
  amountUsd     Float
  currency      String    @default("USD")
  status        String    @default("PENDING")
  payerGtid     String
  payeeGtid     String
  ublXml        String?
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  trade         Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
  @@index([payerGtid, status])
}

model InboxItem {
  id           String    @id @default(cuid())
  tenantGtid   String
  tradeId      String?
  category     String
  priority     Int       @default(50)
  title        String
  description  String
  ctaLabel     String?
  deadline     DateTime?
  dismissed    Boolean   @default(false)
  snoozedUntil DateTime?
  createdAt    DateTime  @default(now())
  trade        Trade?    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tenant       Tenant    @relation(fields: [tenantGtid], references: [gtid], onDelete: Cascade)

  @@index([tenantGtid, dismissed, priority])
  @@index([tenantGtid, createdAt])
  @@index([tradeId])
  @@index([category])
}

model Dispute {
  id                 String               @id @default(cuid())
  tradeId            String
  ustn               String?
  type               String
  status             String               @default("FILED")
  filedByGtid        String
  respondentGtid     String?
  claimAmountUsd     Float
  description        String
  evidenceCount      Int                  @default(0)
  aiRootCause        String?
  resolution         String?
  resolutionNotes    String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  arbitrationCases   ArbitrationCase[]
  causalAttributions CausalAttribution[]
  trade              Trade                @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  evidence           DisputeEvidence?
  experts            DisputeExpert[]
  mediation          DisputeMediation[]
  prediction         DisputePrediction?
  qcOverrideFlags    QcOverrideFlag[]
  proposals          SettlementProposal[]

  @@index([tradeId])
  @@index([status])
  @@index([filedByGtid])
  @@index([createdAt])
}

model FinancingRequest {
  id                  String               @id @default(cuid())
  requestId           String               @unique
  tradeId             String
  borrowerGtid        String
  shipmentSeq         Int?
  ustn                String?
  amountUsd           Float
  totalTradeValue     Float
  financingType       String
  tenorDays           Int
  preferredSettlement String
  preferredCurrency   String               @default("USD")
  collateralType      String
  specialInstructions String?
  recommendedLtv      Float?
  status              String               @default("REQUESTED")
  creditScore         Int?
  defaultProbability  Float?
  creditIntelligence  String?
  biddingWindowEndsAt DateTime?
  blendedApr          Float?
  feeUsd              Float?
  feeLockStatus       String               @default("PENDING")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  agreements          FinancingAgreement[]
  bids                FinancingBid[]
  repayments          FinancingRepayment[]
  borrower            Tenant               @relation("BorrowerFinancing", fields: [borrowerGtid], references: [gtid])
  trade               Trade                @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  rfqLogs             FinancingRfqLog[]
}

model FinancingBid {
  id                     String                   @id @default(cuid())
  bidId                  String                   @unique
  requestId              String
  financierGtid          String
  amountOffered          Float
  apr                    Float
  settlementMethod       String
  collateralRequired     String
  conditions             String?
  noteToBorrower         String?
  isDeFi                 Boolean                  @default(false)
  deFiProtocol           String?
  deFiRiskAcknowledgedAt DateTime?
  matchScore             Int                      @default(0)
  encryptedPayload       String?
  status                 String                   @default("SUBMITTED")
  createdAt              DateTime                 @default(now())
  annex                  FinancingAgreementAnnex?
  financier              Tenant                   @relation(fields: [financierGtid], references: [gtid])
  request                FinancingRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model FinancierPreference {
  id                         String   @id @default(cuid())
  financierGtid              String   @unique
  acceptedBorrowerCountries  String
  minTrustScore              Int      @default(70)
  minTradeValue              Float    @default(10000)
  maxFinancedPerRequest      Float    @default(500000)
  preferredFinancingTypes    String
  preferredSettlementMethods String
  excludedCommodities        String
  geographicMode             String   @default("ALL")
  geographicList             String?
  minTrancheSize             Float    @default(10000)
  defaultAprBenchmark        Float    @default(5.0)
  enableDeFi                 Boolean  @default(false)
  notificationsEnabled       Boolean  @default(true)
  webhookUrl                 String?
  updatedAt                  DateTime @default(now())
}

model FinancingRfqLog {
  id            String           @id @default(cuid())
  requestId     String
  financierGtid String
  matchScore    Int
  deliveredVia  String
  status        String           @default("DELIVERED")
  createdAt     DateTime         @default(now())
  request       FinancingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model FinancingAgreement {
  id                  String                    @id @default(cuid())
  agreementId         String                    @unique
  requestId           String
  masterContractHash  String
  witnessClauseText   String
  borrowerSignedAt    DateTime?
  financierSignedAt   DateTime?
  governorSignedAt    DateTime?
  governorSignature   String?
  status              String                    @default("PENDING_SIGNATURES")
  totalAcceptedAmount Float
  blendedApr          Float
  createdAt           DateTime                  @default(now())
  request             FinancingRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  annexes             FinancingAgreementAnnex[]
}

model FinancingAgreementAnnex {
  id                  String             @id @default(cuid())
  agreementId         String
  bidId               String             @unique
  financierGtid       String
  amountFinanced      Float
  apr                 Float
  tenorDays           Int
  repaymentSchedule   String
  collateralTerms     String
  feeUsd              Float
  borrowerNetProceeds Float
  financierSignedAt   DateTime?
  disbursedAt         DateTime?
  pspSplitReference   String?
  status              String             @default("PENDING")
  createdAt           DateTime           @default(now())
  defiPosition        DeFiPosition?
  bid                 FinancingBid       @relation(fields: [bidId], references: [id], onDelete: Cascade)
  agreement           FinancingAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
}

model FinancingRepayment {
  id            String           @id @default(cuid())
  requestId     String
  annexId       String?
  financierGtid String
  amountUsd     Float
  method        String
  txReference   String?
  detectedVia   String
  status        String           @default("DETECTED")
  repaidAt      DateTime         @default(now())
  request       FinancingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model DeFiProtocol {
  id                 String   @id @default(cuid())
  name               String   @unique
  displayName        String
  chain              String   @default("Ethereum")
  riskScore          Int      @default(85)
  tvlUsd             Float    @default(0)
  auditStatus        String   @default("AUDITED")
  lastExploit        String?
  governanceActivity String   @default("ACTIVE")
  healthColor        String   @default("GREEN")
  contractAddress    String?
  updatedAt          DateTime @default(now())
}

model DeFiPosition {
  id                   String                  @id @default(cuid())
  annexId              String                  @unique
  protocolName         String
  borrowerGtid         String
  financierGtid        String
  principalUsd         Float
  healthFactor         Float                   @default(2.0)
  predictedHealth24h   Float?
  collateralUsd        Float
  debtUsd              Float
  liquidationThreshold Float                   @default(0.8)
  status               String                  @default("ACTIVE")
  lastCheckedAt        DateTime                @default(now())
  createdAt            DateTime                @default(now())
  annex                FinancingAgreementAnnex @relation(fields: [annexId], references: [id], onDelete: Cascade)
}

model StablecoinStatus {
  id                 String   @id @default(cuid())
  symbol             String   @unique
  pegUsd             Float    @default(1.0)
  deviationPct       Float    @default(0.0)
  oracle             String   @default("CoinGecko")
  freezeNewPositions Boolean  @default(false)
  lastCheckedAt      DateTime @default(now())
  updatedAt          DateTime @default(now())
}

model LabTest {
  id          String    @id @default(cuid())
  tradeId     String
  labGtid     String
  testType    String
  sampleRef   String
  status      String    @default("REQUESTED")
  result      String?
  passFail    String?
  parameters  String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  lab         Tenant    @relation(fields: [labGtid], references: [gtid])
  trade       Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model QcInspection {
  id                    String    @id @default(cuid())
  tradeId               String
  qcGtid                String
  inspectionType        String
  inspectorName         String?
  status                String    @default("SCHEDULED")
  result                String?
  defectCount           Int       @default(0)
  notes                 String?
  actionPlan            String?
  conditionalPassStatus String?
  actionPlanDeadline    DateTime?
  defectsJson           String?
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  qc                    Tenant    @relation(fields: [qcGtid], references: [gtid])
  trade                 Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model CustomsDeclaration {
  id            String    @id @default(cuid())
  tradeId       String
  brokerGtid    String?
  declarationNo String?
  regime        String
  status        String    @default("DRAFT")
  dutyUsd       Float?
  etaXml        String?
  nafezaStatus  String?
  clearedAt     DateTime?
  createdAt     DateTime  @default(now())
  broker        Tenant?   @relation(fields: [brokerGtid], references: [gtid])
  trade         Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model ServiceQuotation {
  id                 String    @id @default(cuid())
  quoteId            String    @unique
  tradeId            String?
  ustn               String?
  providerGtid       String
  providerType       String
  serviceType        String
  feeUsd             Float
  currency           String    @default("USD")
  validityDays       Int       @default(7)
  validUntil         DateTime?
  status             String    @default("PENDING")
