// BP-002: Country physical document requirements (RIA)
model CountryPhysicalDocumentRequirement {
  id            String   @id @default(cuid())
  countryCode   String
  documentType  String   // COMMERCIAL_INVOICE | PACKING_LIST | CERTIFICATE_OF_ORIGIN | etc.
  required      Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  @@unique([countryCode, documentType])
  @@index([countryCode])
}

// BP-003: Infrastructure anomaly (self-healing/chaos)
model InfraAnomaly {
  id              String   @id @default(cuid())
  anomalyType     String   // POD_CRASH | NODE_NOT_READY | DISK_PRESSURE | etc.
  target          String   // pod name, node name, etc.
  severity        String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status          String   @default("DETECTED") // DETECTED | INVESTIGATING | HEALING | RESOLVED | IGNORED
  description     String?
  detectedAt      DateTime @default(now())
  resolvedAt      DateTime?
  metadata        String?  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  @@index([status, severity])
  @@index([target])
}

// BP-004: Infrastructure prediction (LSTM failure prediction)
model InfrastructurePrediction {
  id              String   @id @default(cuid())
  targetType      String   // DISK | MEMORY | CPU | NETWORK
  target          String   // node name, disk id, etc.
  prediction      String   // FAILURE | DEGRADATION | HEALTHY
  confidence      Float    // 0.0 to 1.0
  predictedAt     DateTime @default(now())
  expectedFailureAt DateTime?
  modelVersion    String?
  features        String?  // JSON
  createdAt       DateTime @default(now())
  @@index([targetType, prediction])
}

// BP-006: PSP attempt (settlement payment tracking)
model PspAttempt {
  id              String   @id @default(cuid())
  attemptId       String   @unique
  instructionId   String?  // CERT-FIX: link to SettlementInstruction
  instruction     SettlementInstruction? @relation(fields: [instructionId], references: [id], onDelete: Cascade)
  ustn            String
  pspProvider     String   // FAWRY | PAYMOB | STRIPE | CBE_IPN
  stage           String   // STAGE1 | STAGE2
  amountUsd       Float
  currency        String   @default("USD")
  status          String   @default("PENDING") // PENDING | SUCCESS | FAILED | REFUNDED
  pspReference    String?
  pspName         String?  // CERT-FIX: PSP provider name (alias for pspProvider)
  pspSignature    String?  // CERT-FIX: PSP response signature
  attemptNumber   Int      @default(1) // CERT-FIX: attempt sequence number
  pspResponse     String?  // JSON
  errorMessage    String?
  failReason      String?  // CERT-FIX: reason for failure
  attemptedAt     DateTime @default(now())
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  @@index([ustn, status])
  @@index([pspProvider, status])
  @@index([instructionId])
}

// BP-009: Trade Digital Twin scenario (persisted simulations)
model TradeDigitalTwinScenario {
  id              String   @id @default(cuid())
