  originalInspectionId String
  ustn            String
  requestedByGtid String
  reason          String
  sameProvider    Boolean  @default(false) // CERT-FIX: same provider re-inspection
  newQcProviderGtid String? // CERT-FIX: new QC provider for re-inspection
  evidenceNote    String?  // CERT-FIX: evidence notes
  feeUsd          Float?   // CERT-FIX: re-inspection fee
  acceptedAt      DateTime? // CERT-FIX: when the request was accepted
  status          String   @default("REQUESTED") // CERT-FIX: REQUESTED | ACCEPTED | SCHEDULED | COMPLETED
  scheduledAt     DateTime?
  createdAt       DateTime @default(now())
  @@index([ustn, status])
  @@index([requestedByGtid, status])
  @@index([newQcProviderGtid, status])
}

