  scenarioType    String   // TARIFF | CURRENCY | REGULATORY | LOGISTICS | FINANCING
  inputParams     String   // JSON
  outputResults   String?  // JSON
  aiSummary       String?
  status          String   @default("SIMULATED") // SIMULATED | ACKNOWLEDGED | APPLIED
  createdByGtid   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  @@index([ustn, status])
  @@index([scenarioType])
}

// CERT-FIX: Milestone model (referenced by settlement/index.ts)
model Milestone {
  id              String   @id @default(cuid())
  ustn            String
  shipmentId      String?
  type            String   // LOADING | DEPARTURE | ARRIVAL | CUSTOMS_CLEARANCE | DELIVERY | FULL
  status          String   @default("PENDING") // PENDING | CONFIRMED | AUTO_CONFIRMED | FAILED
  label           String?  // CERT-FIX: human-readable label
  sequence        Int      @default(0) // CERT-FIX: ordering sequence
