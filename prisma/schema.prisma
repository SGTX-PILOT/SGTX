// ====================================================================
// INTERNATIONAL AIR CARGO EXECUTION ENGINE (CCL-013)
// Part 1-51: Complete air freight domain for international air cargo
// ====================================================================

model AirCargoShipment {
  id                  String    @id @default(cuid())
  ustn                String
  shipperGtid         String?
  consigneeGtid       String?
  forwarderGtid       String?
  originAirport       String    // IATA code
  destinationAirport  String    // IATA code
  transitAirports     String?   // JSON array
  serviceType         String?   // STANDARD | EXPRESS | PRIORITY | CHARTER
  bookingStatus       String    @default("DRAFT")
  cargoStatus         String    @default("PENDING")
  customsStatus       String    @default("PENDING")
  securityStatus      String    @default("PENDING")
  deliveryStatus      String    @default("PENDING")
  totalPieces         Int       @default(0)
  totalGrossWeight    Float     @default(0)
  totalVolume         Float?    // CBM
  chargeableWeight    Float?    // kg
  currency            String    @default("USD")
  plannedDeparture    DateTime?
  plannedArrival      DateTime?
  deliveryWindow      String?   // JSON {earliest, preferred, latest}
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

