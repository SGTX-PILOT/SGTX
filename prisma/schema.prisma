  uldAssignments       UldAssignment[]
  securityRecords     AirSecurityRecord[]
  dgRecords           AirDgRecord[]
  customsOps          AirCustomsOperation[]
  irregularities      AirIrregularity[]
  iotEvents           AirCargoIotEvent[]

  @@index([ustn])
  @@index([bookingStatus])
  @@index([originAirport, destinationAirport])
}

model AirFlightLeg {
