  flightNumber        String?
  operatingAirline    String?
  marketingAirline    String?
  originAirport       String    // IATA
  destinationAirport  String    // IATA
  scheduledDeparture  DateTime?
  scheduledArrival    DateTime?
  estimatedDeparture  DateTime?
  estimatedArrival    DateTime?
  actualDeparture     DateTime?
  actualArrival       DateTime?
  bookingReference    String?
  allocatedWeight     Float?    // kg
  allocatedVolume     Float?    // CBM
  aircraftType        String?
  cargoCapacity       Float?    // kg
  status              String    @default("SCHEDULED")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  shipment            AirCargoShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

