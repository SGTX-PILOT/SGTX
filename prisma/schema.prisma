model ContainerReleaseAuthorisation {
  id              String   @id @default(cuid())
  authorisationId String   @unique // REL-YYYYMMDD-NNN-NNN
  ustn            String
  containerNo     String
  releaseStatus   String   // AUTHORISED | HOLD | REVOKED | USED | EXPIRED | ERROR
  holdReason      String?  // MANDATORY_PAYMENT_PENDING | DISPUTE_RAISED | CONTAINER_NOT_FOUND | REVOKED | AUTHORISATION_EXPIRED | CONDITIONAL_QC_HOLD | DEFERRED_PAYMENT_EXPIRED | SANCTIONS_BLOCK | CUSTOMS_HOLD | CERTIFICATE_EXPIRED | AUTHORISATION_REVOKED
  requestId       String?  // caller's idempotency UUID
  terminalId      String?  // terminal that queried
  issuedAt        DateTime?
  validUntil      DateTime? // 24h window
