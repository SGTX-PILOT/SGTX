// SGTX Platform — Sovereign Governed Trade Execution
// Prisma schema (SQLite). Blueprint v11.1 — full data model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== Identity =====
model Tenant {
  id              String   @id @default(cuid())
  gtid            String   @unique // SGTX-{COUNTRY}-{TYPE}-{SEQ}-{CHECKSUM}
  legalName       String
  type            String   // TRD | LSP | SHIP | LAB | QC | CBR | BANK | PFI | GOV | ADM | MKT
  country         String   // ISO 3166-1 alpha2
  traderMode      String   @default("NONE") // BUY | SELL | DUAL | NONE
  kybTier         Int      @default(1)
  trustScore      Int      @default(70)
  lifecycleState  String   @default("VERIFIED") // PENDING | VERIFIED | SUSPENDED | EXITED
  sanctionsCleared Boolean @default(true)
  defiAllowed     Boolean  @default(false)
  city            String?
  logoColor       String?
  sector          String?
  createdAt       DateTime @default(now())

  tradesAsBuyer   Trade[]  @relation("BuyerTrades")
  tradesAsSeller  Trade[]  @relation("SellerTrades")
  activities      Activity[]
  inboxItems      InboxItem[]
  employees       Employee[]
  bidFinancing    FinancingBid[]
  financingRequests FinancingRequest[] @relation("BorrowerFinancing")
  labTests        LabTest[]
  qcInspections   QcInspection[]
  customsDecls    CustomsDeclaration[]
  quotations      ServiceQuotation[]
  shipmentsCarrier Shipment[] @relation("CarrierShipments")
}

model Employee {
  id            String   @id @default(cuid())
  tenantGtid    String
  tenant        Tenant   @relation(fields: [tenantGtid], references: [gtid], onDelete: Cascade)
  fullName      String
  email         String
  role          String   // OWNER | ADMIN | OPERATOR | DRIVER | INSPECTOR | ANALYST | OFFICER
  allowRoleSwitching Boolean @default(false)
  avatarColor   String?
  createdAt     DateTime @default(now())
}

// ===== Trade & USTN =====
model Trade {
  id            String   @id @default(cuid())
  ustn          String   @unique // SGTX-{BUYER6}-{SELLER6}-{TS}-{RAND8}
  buyerGtid     String
  sellerGtid    String
  buyer         Tenant   @relation("BuyerTrades", fields: [buyerGtid], references: [gtid])
  seller        Tenant   @relation("SellerTrades", fields: [sellerGtid], references: [gtid])
  commodity     String
  commodityHs   String?
  incoterm      String   // EXW | FCA | FOB | CFR | CIF | DAP | DPU | DDP
  grossWeightKg Int
  netWeightKg   Int
  tradeValueUsd Float
  currency      String   @default("USD")
  originPort    String
  destPort      String
  originCountry String
  destCountry   String
  phase         Int      @default(0) // 0-8
  status        String   @default("INITIATED") // INITIATED | QUOTED | NEGOTIATING | CONTRACT_SIGNED | IN_EXECUTION | DELIVERED | SETTLED | DISPUTED | DISTRESSED
  healthScore   Int      @default(85)
  multiShipment Boolean  @default(false)
  sgtxFeeUsd    Float?
  coldChain     Boolean  @default(false)
  containerCount Int     @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shipments     Shipment[]
  documents     Document[]
  activities    Activity[]
  invoices      Invoice[]
  disputes      Dispute[]
  financing     FinancingRequest[]
  inboxItems    InboxItem[]
  labTests      LabTest[]
  qcInspections QcInspection[]
  customsDecls  CustomsDeclaration[]
  quotations    ServiceQuotation[]
  timeline      TimelineEvent[]
  chatMessages  TradeMessage[]
}

model Shipment {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  ustn          String
  sequence      Int      @default(1) // multi-shipment index
  vesselName    String?
  vesselImo     String?
  containerNo   String?
  containerCount Int     @default(1)
  carrierGtid   String?  // shipping line
  carrier       Tenant?  @relation("CarrierShipments", fields: [carrierGtid], references: [gtid])
  status        String   @default("PLANNED") // PLANNED | LOADED | DEPARTED | IN_TRANSIT | ARRIVED | RELEASED | DELIVERED
  originPort    String
  destPort      String
  etd           DateTime?
  eta           DateTime?
  departedAt    DateTime?
  arrivedAt     DateTime?
  releasedAt    DateTime?
  coldChainTemp Float?
  lat           Float?
  lng           Float?
  createdAt     DateTime @default(now())
}

// ===== Documents =====
model Document {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  type          String   // COMMERCIAL_INVOICE | PACKING_LIST | CERTIFICATE_ORIGIN | PHYTO | HEALTH_CERT | BILL_LADING | CUSTOMS_DECL | LAB_REPORT | QC_REPORT | CONTRACT | LOGISTICS_ADDENDUM
  title         String
  status        String   @default("REQUIRED") // REQUIRED | UPLOADED | VERIFIED | MISSING | REJECTED
  uploadedBy    String?
  fileSizeKb    Int?
  hashSha256    String?
  verifiedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ===== Activity / Audit =====
model Activity {
  id            String   @id @default(cuid())
  tradeId       String?
  trade         Trade?   @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  actorGtid     String?
  actor         Tenant?  @relation(fields: [actorGtid], references: [gtid])
  action        String   // APPROVED_INVOICE | SUBMITTED_DECLARATION | SIGNED_CONTRACT | UPLOADED_DOC | PAID_FEE | CONFIRMED_MILESTONE | FILED_DISPUTE ...
  description   String
  type          String   @default("INFO") // SUCCESS | INFO | WARNING | CRITICAL
  metadata      String?
  createdAt     DateTime @default(now())
}

model TimelineEvent {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  phase         Int
  label         String
  description   String
  actorGtid     String?
  completed     Boolean  @default(false)
  completedAt   DateTime?
  createdAt     DateTime @default(now())
}

model TradeMessage {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  senderGtid    String
  senderName    String
  message       String
  isAi          Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// ===== Invoices & Payments =====
model Invoice {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  type          String   // COMMERCIAL | LOGISTICS | SGTX_FEE | BROKER | LAB | QC | FINANCING
  number        String
  amountUsd     Float
  currency      String   @default("USD")
  status        String   @default("PENDING") // PENDING | APPROVED | PAID | OVERDUE | DISPUTED
  payerGtid     String
  payeeGtid     String
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
}

// ===== Smart Inbox =====
model InboxItem {
  id            String   @id @default(cuid())
  tenantGtid    String
  tenant        Tenant   @relation(fields: [tenantGtid], references: [gtid], onDelete: Cascade)
  tradeId       String?
  trade         Trade?   @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  category      String   // NEEDS_SIGNATURE | NEEDS_APPROVAL | NEEDS_DOCUMENT | NEEDS_PAYMENT | SHIPMENT_ALERT | NEW_OFFER | NEGOTIATION | COMPLIANCE | GENERAL
  priority      Int      @default(50) // 0-100
  title         String
  description   String
  ctaLabel      String?
  deadline      DateTime?
  dismissed     Boolean  @default(false)
  snoozedUntil  DateTime?
  createdAt     DateTime @default(now())
}

// ===== Disputes =====
model Dispute {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  type          String   // QUALITY | DELAY | NON_PAYMENT | DOC_FRAUD | COLD_CHAIN | SERVICE_QUALITY | FINANCING | SGTX_FEE
  status        String   @default("FILED") // FILED | MEDIATION | ARBITRATION | RESOLVED | ESCALATED
  filedByGtid   String
  claimAmountUsd Float
  description   String
  evidenceCount Int      @default(0)
  aiRootCause   String?
  resolution    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ===== Financing =====
model FinancingRequest {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  borrowerGtid  String
  borrower      Tenant   @relation("BorrowerFinancing", fields: [borrowerGtid], references: [gtid])
  amountUsd     Float
  purpose       String   // PRE_SHIPMENT | POST_SHIPMENT | WORKING_CAPITAL
  status        String   @default("OPEN") // OPEN | BIDDING | FUNDED | REJECTED
  apr           Float?
  tenorDays     Int?
  createdAt     DateTime @default(now())
  bids          FinancingBid[]
}

model FinancingBid {
  id            String   @id @default(cuid())
  requestId     String
  request       FinancingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  financierGtid String
  financier     Tenant   @relation(fields: [financierGtid], references: [gtid])
  amountUsd     Float
  apr           Float
  isDeFi        Boolean  @default(false)
  status        String   @default("SUBMITTED") // SUBMITTED | ACCEPTED | REJECTED
  createdAt     DateTime @default(now())
}

// ===== Lab / QC / Customs =====
model LabTest {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  labGtid       String
  lab           Tenant   @relation(fields: [labGtid], references: [gtid])
  testType      String   // PESTICIDE_RESIDUE | MICROBIOLOGICAL | HEAVY_METAL | BRIX | SUGAR_CONTENT
  sampleRef     String
  status        String   @default("REQUESTED") // REQUESTED | SAMPLING | TESTING | COMPLETED | FAILED
  result        String?
  passFail      String?  // PASS | FAIL | CONDITIONAL
  parameters    String?  // JSON string of {param: value}
  completedAt   DateTime?
  createdAt     DateTime @default(now())
}

model QcInspection {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  qcGtid        String
  qc            Tenant   @relation(fields: [qcGtid], references: [gtid])
  inspectionType String  // PRE_SHIPMENT | LOADING | DISCHARGE | CONDITIONAL
  inspectorName String?
  status        String   @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED
  result        String?  // PASS | FAIL | CONDITIONAL_PASS
  defectCount   Int      @default(0)
  notes         String?
  actionPlan    String?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
}

model CustomsDeclaration {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  brokerGtid    String?
  broker        Tenant?  @relation(fields: [brokerGtid], references: [gtid])
  declarationNo String?
  regime        String   // EXPORT | IMPORT
  status        String   @default("DRAFT") // DRAFT | SUBMITTED | ASSESSED | CLEARED | HELD
  dutyUsd       Float?
  etaXml        String?
  nafezaStatus  String?
  clearedAt     DateTime?
  createdAt     DateTime @default(now())
}

model ServiceQuotation {
  id            String   @id @default(cuid())
  tradeId       String?
  trade         Trade?   @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  providerGtid  String
  provider      Tenant   @relation(fields: [providerGtid], references: [gtid])
  serviceType   String   // BROKER | LAB | QC | LOGISTICS
  feeUsd        Float
  validityDays  Int      @default(7)
  status        String   @default("PENDING") // PENDING | ACCEPTED | REJECTED | EXPIRED
  description   String?
  createdAt     DateTime @default(now())
}

// ===== Integrations Health (Nafeza, CargoX, ETA, PSP) =====
model IntegrationHealth {
  id            String   @id @default(cuid())
  name          String   @unique // Nafeza | CargoX | ETA | PSP-Visa | PSP-Mastercard | CBE | AIS
  category      String   // CUSTOMS | DOCS | PAYMENT | BANK | LOGISTICS
  status        String   @default("OPERATIONAL") // OPERATIONAL | DEGRADED | OUTAGE
  latencyMs     Int      @default(420)
  errorRate     Float    @default(0.4)
  uptime30d     Float    @default(99.94)
  lastIncident  String?
  updatedAt     DateTime @default(now())
}

// ===== Part 1: Governor & Loom =====
model GovernorDecision {
  id              String   @id @default(cuid())
  decisionId      String   @unique // dec-xxxxx
  action          String   // contract.sign | trade.create | fee.collect | ...
  actorGtid       String?
  actorEmployeeId String?
  traderMode      String?  // BUY | SELL | DUAL
  resourceUstn    String?
  payload         String?  // JSON
  verdict         String   // ALLOW | DENY | CONDITIONAL
  conditions      String?  // JSON array of conditions
  tenantMessage   String?  // AI-generated plain-language (JSON)
  loomHash        String   // sha256:...
  previousHash    String?
  signature       String   // ed25519:...
  pqcSignature    String?  // dilithium3 (optional)
  moduleVersions  String?  // JSON of WASM module versions used
  aiConfidence    Float?
  createdAt       DateTime @default(now())
}

model LoomVerificationToken {
  id            String   @id @default(cuid())
  ustn          String
  token         String   @unique @default(cuid())
  expiresAt     DateTime // 90 days from creation (set in code)
  createdBy     String?
  revoked       Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// ===== Part 1.7: Jurisdiction Matrix (RIA-driven) =====
model Jurisdiction {
  id            String   @id @default(cuid())
  countryCode   String   @unique // ISO 3166-1 alpha2
  countryName   String
  tier          String   @default("STANDARD") // FULL | STANDARD | LIMITED | RESTRICTED | BLOCKED
  defiAllowed   Boolean  @default(true)
  pspList       String?  // JSON array of allowed PSPs
  notes         String?
  updatedAt     DateTime @default(now())
}

// ===== Part 1.12: Suspicious Activity Reports =====
model SuspiciousActivityReport {
  id              String   @id @default(cuid())
  reportType      String   // FinCEN | EG_AML | EU_ECB
  detectionRule   String   // volume_spike | circular_trade | value_mismatch
  involvedUstns   String   // JSON array
  parties         String   // JSON
  narrative       String   // AI-generated
  draftStatus     String   @default("DRAFT") // DRAFT | FILED | REJECTED
  filingReference String?
  governorDecisionId String?
  loomHash        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ===== Part 2.6: Network / Saved Contacts =====
model SavedContact {
  id              String   @id @default(cuid())
  ownerGtid       String   // tenant who saved the contact
  contactGtid     String   // the saved counterparty GTID
  contactName     String
  contactType     String   // TRD | LSP | SHIP | LAB | QC | CBR | BANK | PFI
  relationship    String?  // buyer | seller | provider | ...
  trustPortrait   String?  // AI-generated plain-language summary
  healthScore     Int      @default(70)
  totalTrades     Int      @default(0)
  autoSaved       Boolean  @default(true)
  createdAt       DateTime @default(now())
}

// ===== Part 2.8: Trade Readiness Assessment =====
model TradeReadiness {
  id              String   @id @default(cuid())
  tenantGtid      String   @unique
  score           Int      @default(0)
  companyScore    Int      @default(0)
  bankingScore    Int      @default(0)
  tradeScore      Int      @default(0)
  securityScore   Int      @default(0)
  legalScore      Int      @default(0)
  checklist       String   // JSON of all items + status
  lastCalculated  DateTime @default(now())
}

// ===== Part 1.9: QES Layer (Egypt Trust Integration) =====
model QesSignature {
  id              String   @id @default(cuid())
  ustn            String?  // linked trade
  signerGtid      String
  signerName      String
  signatureType   String   // STANDARD | AES | QES
  legalEffect     String   // binding | integrity_presumption | handwritten_equivalent
  provider        String   // ZITADEL | SoftHSM | EgyptTrust
  certificateId   String?
  certificateFp   String?  // fingerprint
  documentHash    String   // SHA-256 of signed document
  signatureValue  String   // base64 signature
  createdAt       DateTime @default(now())
}

// ===== Part 1.10: Device Trust & Session Security =====
model DeviceTrust {
  id              String   @id @default(cuid())
  tenantGtid      String
  deviceFingerprint String @unique
  deviceName      String   // e.g. "Mohamed's MacBook Pro"
  platform        String   // macOS | Windows | iOS | Android | Linux
  state           String   @default("NEW") // NEW | TRUSTED | ELEVATED_RISK | BLOCKED | REVOKED
  passkeyEnrolled Boolean  @default(false)
  lastSeenIp      String?
  lastSeenCountry String?
  lastSeenAt      DateTime @default(now())
  riskScore       Int      @default(0) // 0-100
  createdAt       DateTime @default(now())
}

model SessionRiskEvent {
  id              String   @id @default(cuid())
  tenantGtid      String
  deviceFingerprint String?
  eventType       String   // impossible_travel | vpn_detected | tor_detected | country_mismatch | fingerprint_change | behavioural_anomaly
  severity        String   @default("medium") // low | medium | high | critical
  description     String
  ipAddress       String?
  countryCode     String?
  metadata        String?  // JSON
  resolved        Boolean  @default(false)
  createdAt       DateTime @default(now())
}

// ===== Part 1.11: Court Evidence Package Engine =====
model EvidencePackage {
  id              String   @id @default(cuid())
  ustn            String
  packageType     String   // PDF | ZIP | COURT_BUNDLE | ARBITRATION_BUNDLE
  jurisdiction    String   // UK | EGYPT | ICC | DIFC_LCIA | CRCICA | LCIA
  status          String   @default("GENERATED") // GENERATED | PENDING | FAILED
  contents        String   // JSON list of included items
  fileSizeKb      Int?
  loomHash        String?  // anchored to Loom chain
  generatedBy     String?
  createdAt       DateTime @default(now())
}

// ===== Part 1.13: Compliance Intelligence Layer =====
model ComplianceScreening {
  id              String   @id @default(cuid())
  ustn            String?
  tenantGtid      String
  screeningType   String   // SANCTIONS | PEP | RESTRICTED_GOODS | JURISDICTION_RISK | CUSTOMS_COMPLIANCE
  verdict         String   @default("CLEAR") // CLEAR | ENHANCED_DUE_DILIGENCE | BLOCKED
  dataSource      String   // RIA | GNN | Nafeza | scraped
  details         String?  // JSON with hits, scores, proximity
  reviewed        Boolean  @default(false)
  reviewedBy      String?
  createdAt       DateTime @default(now())
}

// ===== Part 1.2: OPA Policies (for visualization/hot-reload) =====
model OpaPolicy {
  id              String   @id @default(cuid())
  name            String   @unique // permissions.rego | fee.rego | ...
  category        String   // permissions | fee | financing | distressed | multiship | logistics | broker
  content         String   // Rego source
  version         String   @default("v1.0.0")
  active          Boolean  @default(true)
  lastReloaded    DateTime @default(now())
  multisigApproved Boolean @default(false)
  createdAt       DateTime @default(now())
}


